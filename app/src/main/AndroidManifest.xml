<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Загрузка времени намаза с aladhan.com -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Уведомления о времени намаза и будильник -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Будильник на фаджр: точное время, показ поверх экрана блокировки, звук и вибрация -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Фоновые службы: будильник (звук) и запасной режим блокировки -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Восстановление будильников после перезагрузки -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Определение города для расчёта времени намаза -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Точное место — чтобы показать ближайшие мечети на карте -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Учёт времени в соцсетях. Выдаётся пользователем в настройках «Доступ к истории использования» -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Чтобы показать список установленных приложений для выбора -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ZikrApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZikrTime">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Будильник на фаджр: показывается поверх экрана блокировки -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="com.zikrtime.app.alarm" />

        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Экран, который появляется поверх соцсетей, когда лимит исчерпан или идёт время намаза -->
        <activity
            android:name=".screentime.PauseActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="com.zikrtime.app.pause" />
        <activity
            android:name=".screentime.BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.zikrtime.app.block" />

        <service
            android:name=".screentime.BlockerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Запасной режим: следит за лимитом без службы специальных возможностей -->
        <service
            android:name=".screentime.GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled social media time limit: checks the daily limit and shows a reminder." />
        </service>

        <receiver
            android:name=".prayer.PrayerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".prayer.FridayReceiver"
            android:exported="false" />

        <activity android:name=".widget.WidgetConfigActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".widget.CompactPrayerWidget" android:exported="false" android:label="@string/widget_compact_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compact" />
        </receiver>
        <receiver android:name=".widget.TimelineWidget" android:exported="false" android:label="@string/widget_timeline_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timeline" />
        </receiver>
        <!-- Виджеты на рабочий стол -->
        <receiver
            android:name=".widget.NextPrayerWidget"
            android:exported="false"
            android:label="@string/widget_square_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next" />
        </receiver>
        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false"
            android:label="@string/widget_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today" />
        </receiver>
        <receiver
            android:name=".widget.ScreenTimeWidget"
            android:exported="false"
            android:label="@string/widget_screen_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_screen" />
        </receiver>

        <receiver
            android:name=".widget.TasbihWidget"
            android:exported="false"
            android:label="@string/widget_tasbih_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasbih" />
        </receiver>

        <receiver
            android:name=".prayer.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
