<?xml version="1.0" encoding="utf-8"?>
<!-- Фон виджетов: изумрудный градиент со скруглением и тонкой золотой рамкой -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#0F5C4A" android:centerColor="#0B4A3B" android:endColor="#05281F" android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="220dp" android:centerX="0.15" android:centerY="0.0"
                android:startColor="#33FFE7A8" android:endColor="#00FFE7A8" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#40E2B659" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
