<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- Небо по времени суток (рисуется в приложении) -->
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/w_star"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="-18dp"
        android:layout_marginBottom="-18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_star" />

    <!-- Кольцо: сколько прошло от прошлого намаза до следующего -->
    <ImageView
        android:id="@+id/w_ring"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="52dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D9FFF6E0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="48dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFF6E0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FFE7A8"
            android:textSize="34sp" />

        <Chronometer
            android:id="@+id/w_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_chip"
            android:countDown="true"
            android:maxLines="1"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:textColor="#FFF6E0"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
