<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
    <ImageView android:id="@+id/w_star" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:fontFamily="serif" android:textStyle="bold" android:textColor="#30271F" />
                <TextView android:id="@+id/w_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="#736457" />
            </LinearLayout>
            <Chronometer android:id="@+id/w_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="126dp" android:maxLines="1" android:ellipsize="end" android:background="@drawable/widget_chip" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:textSize="11sp" android:textColor="#30271F" />
        </LinearLayout>
        <ImageView android:id="@+id/w_arc" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/w_col0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_marginVertical="1dp" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_icon0" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:tint="#3D5037" />
                <TextView android:id="@+id/w_name0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#736457" android:textSize="11sp" />
                <TextView android:id="@+id/w_time0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="#30271F" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_col3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_marginVertical="1dp" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_icon3" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:tint="#3D5037" />
                <TextView android:id="@+id/w_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#736457" android:textSize="11sp" />
                <TextView android:id="@+id/w_time3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="#30271F" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/w_col1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_marginVertical="1dp" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_icon1" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:tint="#3D5037" />
                <TextView android:id="@+id/w_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#736457" android:textSize="11sp" />
                <TextView android:id="@+id/w_time1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="#30271F" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_col4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_marginVertical="1dp" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_icon4" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:tint="#3D5037" />
                <TextView android:id="@+id/w_name4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#736457" android:textSize="11sp" />
                <TextView android:id="@+id/w_time4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="#30271F" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/w_col2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_marginVertical="1dp" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_icon2" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:tint="#3D5037" />
                <TextView android:id="@+id/w_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#736457" android:textSize="11sp" />
                <TextView android:id="@+id/w_time2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="#30271F" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_col5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:layout_marginVertical="1dp" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_icon5" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:tint="#3D5037" />
                <TextView android:id="@+id/w_name5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#736457" android:textSize="11sp" />
                <TextView android:id="@+id/w_time5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:maxLines="1" android:textColor="#30271F" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
