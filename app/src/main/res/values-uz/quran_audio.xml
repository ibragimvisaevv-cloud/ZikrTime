    <string name="qaudio_delete_title">Yuklangan sura o‘chirilsinmi?</string>
    <string name="qaudio_delete_detail">“%1$s” surasini qayta tinglash uchun internet kerak bo‘ladi. Qur’ondagi xatcho‘plar va qaydlar saqlanadi.</string>
