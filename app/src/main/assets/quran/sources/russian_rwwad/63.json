b\u0438 \u0432\u0435\u0440\u0443, \u0438 \u043d\u0430 \u0438\u0445 \u0441\u0435\u0440\u0434\u0446\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0430 \u043f\u0435\u0447\u0430\u0442\u044c, \u0442\u0430\u043a \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0442.","footnotes":""},{"id":"5192","sura":"63","aya":"4","arabic_text":"\u06de\u00a0\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u064a\u06e1\u062a\u064e\u0647\u064f\u0645\u06e1 \u062a\u064f\u0639\u06e1\u062c\u0650\u0628\u064f\u0643\u064e \u0623\u064e\u062c\u06e1\u0633\u064e\u0627\u0645\u064f\u0647\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0625\u0650\u0646 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0627\u0652 \u062a\u064e\u0633\u06e1\u0645\u064e\u0639\u06e1 \u0644\u0650\u0642\u064e\u0648\u06e1\u0644\u0650\u0647\u0650\u0645\u06e1\u06d6 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062e\u064f\u0634\u064f\u0628\u065e \u0645\u0651\u064f\u0633\u064e\u0646\u0651\u064e\u062f\u064e\u0629\u065e\u06d6 \u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f\u0648\u0646\u064e \u0643\u064f\u0644\u0651\u064e \u0635\u064e\u064a\u06e1\u062d\u064e\u0629\u064d \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1\u06da \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0639\u064e\u062f\u064f\u0648\u0651\u064f \u0641\u064e\u0671\u062d\u06e1\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1\u06da \u0642\u064e\u0670\u062a\u064e\u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06d6 \u0623\u064e\u0646\u0651\u064e\u0649\u0670 \u064a\u064f\u0624\u06e1\u0641\u064e\u0643\u064f\u0648\u0646\u064e","translation":"\u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u0432\u0438\u0434\u0438\u0448\u044c \u0438\u0445, \u0438\u0445 \u043e\u0431\u043b\u0438\u043a \u0432\u043e\u0441\u0445\u0438\u0449\u0430\u0435\u0442 \u0442\u0435\u0431\u044f, \u0430 \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u0433\u043e\u04