0651\u064e\u0628\u064f\u0648\u0627\u0652 \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0643\u0650\u0630\u0651\u064e\u0627\u0628\u0657\u0627","translation":"\u0438 \u0443\u043f\u043e\u0440\u043d\u043e \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u041d\u0430\u0448\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u044f \u043b\u043e\u0436\u044c\u044e.","footnotes":""},{"id":"5701","sura":"78","aya":"29","arabic_text":"\u0648\u064e\u0643\u064f\u0644\u0651\u064e \u0634\u064e\u064a\u06e1\u0621\u064d \u0623\u064e\u062d\u06e1\u0635\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064f \u0643\u0650\u062a\u064e\u0670\u0628\u0657\u0627","translation":"\u041d\u043e \u041c\u044b \u0443\u0436\u0435 \u0438\u0441\u0447\u0438\u0441\u043b\u0438\u043b\u0438 \u0432\u0441\u0451 \u0441\u0443\u0449\u0435\u0435 \u0432 \u041f\u0438\u0441\u0430\u043d\u0438\u0438.","footnotes":""},{"id":"5702","sura":"78","aya":"30","arabic_text":"\u0641\u064e\u0630\u064f\u0648\u0642\u064f\u0648\u0627\u0652 \u0641\u064e\u0644\u064e\u0646 \u0646\u0651\u064e\u0632\u0650\u064a\u062f\u064e\u0643\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0630\u064e\u0627\u0628\u064b\u0627","translation":"\u00ab\u0422\u0430\u043a \u0432\u043a\u0443\u0448\u0430\u0439\u0442\u0435 \u0436\u0435! \u041c\u044b \u043d\u0435 \u043f\u0440\u0438\u0431\u0430\u0432\u0438\u043c \u0432\u0430\u043c \u043d\u0438\u0447\u0435\u0433\u043e, \u043a\u0440\u043e\u043c\u0435 \u043c\u0443\u0447\u0435\u043d\u0438\u044f\u00bb.","footnotes":""},{"id":"5703","sura":"78","aya":"31","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0645\u064e\u0641\u064e\u0627\u0632\u064b\u0627","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0434\u043b\u044f \u0431\u043e\u0433\u043e\u0431\u043e\u044f\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u2014 \u043c\u0435\u0441\u0442\u043e \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f:","footnotes":""},{"id":"5704","sura":"78","aya":"32","arabic_text":"\u062d\u064e\u062f\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u0648\u064e\u0623\u064e\u0639\u06e1\u0646\u064e\u0670\u0628\u0657\u0627","translation":"\u0441\u0430\u0434\u044b \u0438 \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u0438\u043a\u0438,","footnotes":""},{"id":"5705","sura":"78","aya":"33","arabic_text":"\u0648\u064e\u0643\u064e\u0648\u064e\u0627\u0639\u0650\u0628\u064e \u0623\u064e\u062a\u06e1\u0631\u064e\u0627\u0628\u0657\u0627","translation":"\u0438 \u043f\u043e\u043b\u043d\u043e\u0433\u0440\u0443\u0434\u044b\u0435 \u0441\u0432\u0435\u0440\u0441\u0442\u043d\u0438\u0446\u044b,","footnotes":""},{"id":"5706","sura":"78","aya":"34","arabic_text":"\u0648\u064e\u0643\u064e\u0623\u06e1\u0633\u0657\u0627 \u062f\u0650\u0647\u064e\u0627\u0642\u0657\u0627","translation":"\u0438 \u043a\u0443\u0431\u043a\u0438, \u043f\u043e\u043b\u043d\u044b\u0435 \u0434\u043e \u043a\u0440\u0430\u0451\u0432.","footnotes":""},{"id":"5707","sura":"78","aya":"35","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0633\u06e1\u0645\u064e\u0639\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0644\u064e\u063a\u06e1\u0648\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0643\u0650\u0630\u0651\u064e\u0670\u0628\u0657\u0627","translation":"\u041e\u043d\u0438 \u043d\u0435 \u0443\u0441\u043b\u044b\u0448\u0430\u0442 \u0442\u0430\u043c \u043d\u0438 \u043f\u0443\u0441\u0442\u043e\u0441\u043b\u043e\u0432\u0438\u044f, \u043d\u0438 \u043b\u0436\u0438 \u2014","footnotes":""},{"id":"5708","sura":"78","aya":"36","arabic_text":"\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u0657 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064e \u0639\u064e\u0637\u064e\u0627\u0653\u0621\u064b \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627","translation":"\u0432 \u0432\u043e\u0437\u0434\u0430\u044f\u043d\u0438\u0435 \u043e\u0442 \u0442\u0432\u043e\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430, \u0434\u0430\u0440\u043e\u043c, [\u043e\u0442\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u043c] \u0441\u043f\u043e\u043b\u043d\u0430,","footnotes":""},{"id":"5709","sura":"78","aya":"37","arabic_text":"\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650\u06d6 \u0644\u064e\u0627 \u064a\u064e\u0645\u06e1\u0644\u0650\u0643\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u062e\u0650\u0637\u064e\u0627\u0628\u0657\u0627","translation":"\u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0435\u0431\u0435\u0441 \u0438 \u0437\u0435\u043c\u043b\u0438 \u0438 \u0432\u0441\u0435\u0433\u043e, \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438, \u2014 \u0412\u0441\u0435\u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u043e\u0433\u043e, \u043f\u0440\u0435\u0434 \u041a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u043d\u0438 \u043d\u0435 \u0432\u043b\u0430\u0441\u0442\u043d\u044b \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c.","footnotes":""},{"id":"5710","sura":"78","aya":"38","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0642\u064f\u0648\u0645\u064f \u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0635\u064e\u0641\u0651\u0657\u0627\u06d6 \u0644\u0651\u064e\u0627 \u064a\u064e\u062a\u064e\u0643\u064e\u0644\u0651\u064e\u0645\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064e\u0630\u0650\u0646\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f \u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0635\u064e\u0648\u064e\u0627\u0628\u0657\u0627","translation":"\u0412 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c \u0414\u0443\u0445 \u0438 \u0430\u043d\u0433\u0435\u043b\u044b \u0432\u0441\u0442\u0430\u043d\u0443\u0442 \u0440\u044f\u0434\u0430\u043c\u0438. \u041d\u0435 \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043e\u043d\u0438, \u043a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u043a\u043e\u043c\u0443 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442 \u0412\u0441\u0435\u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u044b\u0439, \u2014 \u0438 \u043e\u043d \u0441\u043a\u0430\u0436\u0435\u0442 \u0432\u0435\u0440\u043d\u043e\u0435.","footnotes":""},{"id":"5711","sura":"78","aya":"39","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u064f\u06d6 \u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0645\u064e\u0640\u0654\u064e\u0627\u0628\u064b\u0627","translation":"\u042d\u0442\u043e \u2014 \u0414\u0435\u043d\u044c \u0438\u0441\u0442\u0438\u043d\u044b. \u0422\u0430\u043a \u043f\u0443\u0441\u0442\u044c \u0442\u043e\u0442, \u043a\u0442\u043e \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442, \u043d\u0430\u0439\u0434\u0451\u0442 \u043f\u0443\u0442\u044c \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u0413\u043e\u0441\u043f\u043e\u0434\u0443.","footnotes":""},{"id":"5712","sura":"78","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0630\u064e\u0631\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0657\u0627 \u0642\u064e\u0631\u0650\u064a\u0628\u0657\u0627 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0646\u0638\u064f\u0631\u064f \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0621\u064f \u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u06e1 \u064a\u064e\u062f\u064e\u0627\u0647\u064f \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0671\u0644\u06e1\u0643\u064e\u0627\u0641\u0650\u0631\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0643\u064f\u0646\u062a\u064f \u062a\u064f\u0631\u064e\u0670\u0628\u064e\u06e2\u0627","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041c\u044b \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0433\u043b\u0438 \u0432\u0430\u0441 \u043e\u0442 \u0431\u043b\u0438\u0437\u043a\u043e\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u2014 \u0432 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c, \u043a\u043e\u0433\u0434\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0443\u0432\u0438\u0434\u0438\u0442 \u0442\u043e, \u0447\u0442\u043e \u0443\u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0438 \u0435\u0433\u043e \u0440\u0443\u043a\u0438, \u0438 \u0441\u043a\u0430\u0436\u0435\u0442 \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0439 \u0432\u0435\u0440\u0443: \u00ab\u041e, \u0435\u0441\u043b\u0438 \u0431\u044b \u044f \u0431\u044b\u043b \u043f\u0440\u0430\u0445\u043e\u043c...\u00bb","footnotes":""}]}