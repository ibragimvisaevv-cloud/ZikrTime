639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"\u0418 \u043a\u0430\u043a\u043e\u0432\u044b \u0436\u0435 \u0431\u044b\u043b\u0438 \u041c\u043e\u0451 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f!","footnotes":""},{"id":"4868","sura":"54","aya":"22","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u064a\u064e\u0633\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e \u0644\u0650\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u0650 \u0641\u064e\u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u0656","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u041c\u044b \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u043b\u0438 \u041a\u043e\u0440\u0430\u043d \u0434\u043b\u044f \u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f. \u0418 \u0435\u0441\u0442\u044c \u043b\u0438 \u0442\u043e\u0442, \u043a\u0442\u043e \u0432\u043d\u0435\u043c\u043b\u0435\u0442 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044e?","footnotes":""},{"id":"4869","sura":"54","aya":"23","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u06e1 \u062b\u064e\u0645\u064f\u0648\u062f\u064f \u0628\u0650\u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u0650","translation":"\u041f\u043b\u0435\u043c\u044f \u0441\u0430\u043c\u0443\u0434 \u0441\u043e\u0447\u043b\u043e \u043b\u043e\u0436\u044c\u044e \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f,","footnotes":""},{"id":"4870","sura":"54","aya":"24","arabic_text":"\u0641\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0628\u064e\u0634\u064e\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u0651\u064e\u0627 \u0648\u064e\u0670\u062d\u0650\u062f\u0657\u0627 \u0646\u0651\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0625\u0650\u0630\u0657\u0627 \u0644\u0651\u064e\u0641\u0650\u064a \u0636\u064e\u0644\u064e\u0670\u0644\u0656 \u0648\u064e\u0633\u064f\u0639\u064f\u0631\u064d","translation":"\u0438 \u043e\u043d\u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0438: \u00ab\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u043c\u044b \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u0435\u043c \u0437\u0430 \u043e\u0434\u043d\u0438\u043c-\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u0438\u0437 \u043d\u0430\u0441? \u0422\u043e\u0433\u0434\u0430, \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u043c\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u0431\u044b \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0438 \u0438 \u0431\u0435\u0437\u0443\u043c\u0438\u0438.","footnotes":""},{"id":"4871","sura":"54","aya":"25","arabic_text":"\u0623\u064e\u0621\u064f\u0644\u06e1\u0642\u0650\u064a\u064e \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u06e2 \u0628\u064e\u064a\u06e1\u0646\u0650\u0646\u064e\u0627 \u0628\u064e\u0644\u06e1 \u0647\u064f\u0648\u064e \u0643\u064e\u0630\u0651\u064e\u0627\u0628\u064c \u0623\u064e\u0634\u0650\u0631\u065e","translation":"\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u041d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043d\u0438\u0441\u043f\u043e\u0441\u043b\u0430\u043d\u043e \u0435\u043c\u0443 \u043e\u0434\u043d\u043e\u043c\u0443 \u0441\u0440\u0435\u0434\u0438 \u043d\u0430\u0441? \u041d\u0435\u0442, \u043d\u0430\u043f\u0440\u043e\u0442\u0438\u0432! \u041e\u043d \u2014 \u0434\u0435\u0440\u0437\u043a\u0438\u0439 \u043b\u0436\u0435\u0446\u00bb.","footnotes":""},{"id":"4872","sura":"54","aya":"26","arabic_text":"\u0633\u064e\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u063a\u064e\u062f\u0657\u0627 \u0645\u0651\u064e\u0646\u0650 \u0671\u0644\u06e1\u0643\u064e\u0630\u0651\u064e\u0627\u0628\u064f \u0671\u0644\u06e1\u0623\u064e\u0634\u0650\u0631\u064f","translation":"\u0421\u043a\u043e\u0440\u043e \u043e\u043d\u0438 \u0443\u0437\u043d\u0430\u044e\u0442, \u043a\u0442\u043e \u0434\u0435\u0440\u0437\u043a\u0438\u0439 \u043b\u0436\u0435\u0446!","footnotes":""},{"id":"4873","sura":"54","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0645\u064f\u0631\u06e1\u0633\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0646\u0651\u064e\u0627\u0642\u064e\u0629\u0650 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u0671\u0631\u06e1\u062a\u064e\u0642\u0650\u0628\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0671\u0635\u06e1\u0637\u064e\u0628\u0650\u0631\u06e1","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041c\u044b \u043f\u043e\u0448\u043b\u0451\u043c \u0438\u043c \u0432\u0435\u0440\u0431\u043b\u044e\u0434\u0438\u0446\u0443 \u043a\u0430\u043a \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435. \u0422\u0430\u043a \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0439 \u0436\u0435 \u0437\u0430 \u043d\u0438\u043c\u0438 \u0438 \u0431\u0443\u0434\u044c \u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432.","footnotes":""},{"id":"4874","sura":"54","aya":"28","arabic_text":"\u0648\u064e\u0646\u064e\u0628\u0651\u0650\u0626\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0642\u0650\u0633\u06e1\u0645\u064e\u0629\u064f\u06e2 \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u06e1\u06d6 \u0643\u064f\u0644\u0651\u064f \u0634\u0650\u0631\u06e1\u0628\u0656 \u0645\u0651\u064f\u062d\u06e1\u062a\u064e\u0636\u064e\u0631\u065e","translation":"\u0418 \u0441\u043e\u043e\u0431\u0449\u0438 \u0438\u043c, \u0447\u0442\u043e \u0432\u043e\u0434\u0430 \u043f\u043e\u0434\u0435\u043b\u0435\u043d\u0430 \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438: \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u2014 \u0435\u0433\u043e \u0447\u0435\u0440\u0451\u0434 \u043f\u0438\u0442\u044c\u044f.","footnotes":""},{"id":"4875","sura":"54","aya":"29","arabic_text":"\u0641\u064e\u0646\u064e\u0627\u062f\u064e\u0648\u06e1\u0627\u0652 \u0635\u064e\u0627\u062d\u0650\u0628\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u062a\u064e\u0639\u064e\u0627\u0637\u064e\u0649\u0670 \u0641\u064e\u0639\u064e\u0642\u064e\u0631\u064e","translation":"\u041d\u043e \u043e\u043d\u0438 \u043f\u043e\u0437\u0432\u0430\u043b\u0438 \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u043e\u043f\u043b\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0430, \u0438 \u043e\u043d \u0432\u0437\u044f\u043b\u0441\u044f [\u0437\u0430 \u0434\u0435\u043b\u043e] \u0438 \u043f\u043e\u0434\u0441\u0451\u043a [\u0435\u0439] \u043f\u043e\u0434\u0436\u0438\u043b\u043a\u0438.","footnotes":""},{"id":"4876","sura":"54","aya":"30","arabic_text":"\u0641\u064e\u0643\u064e\u064a\u06e1\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"\u0418 \u043a\u0430\u043a\u043e\u0432\u044b \u0436\u0435 \u0431\u044b\u043b\u0438 \u041c\u043e\u0451 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f!","footnotes":""},{"id":"4877","sura":"54","aya":"31","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0631\u06e1\u0633\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0635\u064e\u064a\u06e1\u062d\u064e\u0629\u0657 \u0648\u064e\u0670\u062d\u0650\u062f\u064e\u0629\u0657 \u0641\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0643\u064e\u0647\u064e\u0634\u0650\u064a\u0645\u0650 \u0671\u0644\u06e1\u0645\u064f\u062d\u06e1\u062a\u064e\u0638\u0650\u0631\u0650","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041c\u044b \u043d\u0430\u0441\u043b\u0430\u043b\u0438 \u043d\u0430 \u043d\u0438\u0445 \u043e\u0434\u0438\u043d-\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0413\u043b\u0430\u0441, \u0438 \u043e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438 \u043f\u043e\u0434\u043e\u0431\u043d\u044b \u0441\u0443\u0445\u043e\u043c\u0443 \u0445\u0432\u043e\u0440\u043e\u0441\u0442\u0443 \u0434\u043b\u044f \u0438\u0437\u0433\u043e\u0440\u043e\u0434\u0438.","footnotes":""},{"id":"4878","sura":"54","aya":"32","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u064a\u064e\u0633\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e \u0644\u0650\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u0650 \u0641\u064e\u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u0656","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u041c\u044b \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u043b\u0438 \u041a\u043e\u0440\u0430\u043d \u0434\u043b\u044f \u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f. \u0418 \u0435\u0441\u0442\u044c \u043b\u0438 \u0442\u043e\u0442, \u043a\u0442\u043e \u0432\u043d\u0435\u043c\u043b\u0435\u0442 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044e?","footnotes":""},{"id":"4879","sura":"54","aya":"33","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u06e1 \u0642\u064e\u0648\u06e1\u0645\u064f \u0644\u064f\u0648\u0637\u0650\u06ed \u0628\u0650\u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u0650","translation":"\u041d\u0430\u0440\u043e\u0434 \u041b\u0443\u0442\u0430 \u0441\u0447\u0451\u043b \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f \u043b\u043e\u0436\u044c\u044e.","footnotes":""},{"id":"4880","sura":"54","aya":"34","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0631\u06e1\u0633\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u062d\u064e\u0627\u0635\u0650\u0628\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0621\u064e\u0627\u0644\u064e \u0644\u064f\u0648\u0637\u0656\u06d6 \u0646\u0651\u064e\u062c\u0651\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0628\u0650\u0633\u064e\u062d\u064e\u0631\u0656","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041c\u044b \u043f\u043e\u0441\u043b\u0430\u043b\u0438 \u043d\u0430 \u043d\u0438\u0445 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0445\u0440\u044c, \u043a\u0440\u043e\u043c\u0435 \u0441\u0435\u043c\u044c\u0438 \u041b\u0443\u0442\u0430 \u2014 \u041c\u044b \u0441\u043f\u0430\u0441\u043b\u0438 \u0438\u0445 \u0432 \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f,","footnotes":""},{"id":"4881","sura":"54","aya":"35","arabic_text":"\u0646\u0651\u0650\u0639\u06e1\u0645\u064e\u0629\u0657 \u0645\u0651\u0650\u0646\u06e1 \u0639\u0650\u0646\u062f\u0650\u0646\u064e\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u062c\u06e1\u0632\u0650\u064a \u0645\u064e\u0646 \u0634\u064e\u0643\u064e\u0631\u064e","translation":"\u0431\u043b\u0430\u0433\u043e\u0434\u0435\u044f\u043d\u0438\u0435\u043c \u043e\u0442 \u041d\u0430\u0441. \u0422\u0430\u043a \u041c\u044b \u0432\u043e\u0437\u0434\u0430\u0451\u043c \u0442\u0435\u043c, \u043a\u0442\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0435\u043d.","footnotes":""},{"id":"4882","sura":"54","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0623\u064e\u0646\u0630\u064e\u0631\u064e\u0647\u064f\u0645 \u0628\u064e\u0637\u06e1\u0634\u064e\u062a\u064e\u0646\u064e\u0627 \u0641\u064e\u062a\u064e\u0645\u064e\u0627\u0631\u064e\u0648\u06e1\u0627\u0652 \u0628\u0650\u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u0650","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043e\u043d \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u043b \u0438\u0445 \u043e \u041d\u0430\u0448\u0435\u0439 \u0445\u0432\u0430\u0442\u043a\u0435, \u043d\u043e \u043e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438 \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f.","footnotes":""},{"id":"4883","sura":"54","aya":"37","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0670\u0648\u064e\u062f\u064f\u0648\u0647\u064f \u0639\u064e\u0646 \u0636\u064e\u064a\u06e1\u0641\u0650\u0647\u0650\u06e6 \u0641\u064e\u0637\u064e\u0645\u064e\u0633\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0639\u06e1\u064a\u064f\u0646\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u0630\u064f\u0648\u0642\u064f\u0648\u0627\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043e\u043d\u0438 \u0434\u043e\u043c\u043e\u0433\u0430\u043b\u0438\u0441\u044c \u0435\u0433\u043e \u0433\u043e\u0441\u0442\u0435\u0439, \u0438 \u0442\u043e\u0433\u0434\u0430 \u041c\u044b \u043b\u0438\u0448\u0438\u043b\u0438 \u0438\u0445 \u0437\u0440\u0435\u043d\u0438\u044f: \u00ab\u0412\u043a\u0443\u0441\u0438\u0442\u0435 \u0436\u0435 \u041c\u043e\u0451 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0438 \u041c\u043e\u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f!\u00bb","footnotes":""},{"id":"4884","sura":"54","aya":"38","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0635\u064e\u0628\u0651\u064e\u062d\u064e\u0647\u064f\u0645 \u0628\u064f\u0643\u06e1\u0631\u064e\u0629\u064b \u0639\u064e\u0630\u064e\u0627\u0628\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0642\u0650\u0631\u0651\u065e","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0440\u0430\u043d\u043e \u0443\u0442\u0440\u043e\u043c \u0438\u0445 \u043f\u043e\u0441\u0442\u0438\u0433\u043b\u043e \u043d\u0435\u043f\u0440\u0435\u0445\u043e\u0434\u044f\u0449\u0435\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435.","footnotes":""},{"id":"4885","sura":"54","aya":"39","arabic_text":"\u0641\u064e\u0630\u064f\u0648\u0642\u064f\u0648\u0627\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"\u00ab\u0412\u043a\u0443\u0441\u0438\u0442\u0435 \u0436\u0435 \u041c\u043e\u0451 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0438 \u041c\u043e\u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f!\u00bb","footnotes":""},{"id":"4886","sura":"54","aya":"40","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u064a\u064e\u0633\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e \u0644\u0650\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u0650 \u0641\u064e\u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u0656","translation":"\u0418 \u043d\u0435\u0441\u043e\u043c\u043d\u0435\u043d\u043d\u043e \u041c\u044b \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u043b\u0438 \u041a\u043e\u0440\u0430\u043d \u0434\u043b\u044f \u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f. \u0418 \u0435\u0441\u0442\u044c \u043b\u0438 \u0442\u043e\u0442, \u043a\u0442\u043e \u0432\u043d\u0435\u043c\u043b\u0435\u0442 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044e?","footnotes":""},{"id":"4887","sura":"54","aya":"41","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e \u0621\u064e\u0627\u0644\u064e \u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u064f","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u0438 \u043a \u0440\u043e\u0434\u0443 \u0424\u0430\u0440\u0430\u043e\u043d\u0430.","footnotes":""},{"id":"4888","sura":"54","aya":"42","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0627\u0652 \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0643\u064f\u0644\u0651\u0650\u0647\u064e\u0627 \u0641\u064e\u0623\u064e\u062e\u064e\u0630\u06e1\u0646\u064e\u0670\u0647\u064f\u0645\u06e1 \u0623\u064e\u062e\u06e1\u0630\u064e \u0639\u064e\u0632\u0650\u064a\u0632\u0656 \u0645\u0651\u064f\u0642\u06e1\u062a\u064e\u062f\u0650\u0631\u064d","translation":"\u041e\u043d\u0438 \u0441\u043e\u0447\u043b\u0438 \u041d\u0430\u0448\u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u044f \u043b\u043e\u0436\u044c\u044e, \u0432\u0441\u0435 \u0434\u043e \u0435\u0434\u0438\u043d\u043e\u0433\u043e, \u0438 \u041c\u044b \u0441\u0445\u0432\u0430\u0442\u0438\u043b\u0438 \u0438\u0445 \u0445\u0432\u0430\u0442\u043a\u043e\u0439 \u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e, \u0432\u0441\u0435\u0441\u0438\u043b\u044c\u043d\u043e\u0433\u043e.","footnotes":""},{"id":"4889","sura":"54","aya":"43","arabic_text":"\u0623\u064e\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u064f\u0643\u064f\u0645\u06e1 \u062e\u064e\u064a\u06e1\u0631\u065e \u0645\u0651\u0650\u0646\u06e1 \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064f\u0645\u06e1 \u0623\u064e\u0645\u06e1 \u0644\u064e\u0643\u064f\u0645 \u0628\u064e\u0631\u064e\u0627\u0653\u0621\u064e\u0629\u065e \u0641\u0650\u064a \u0671\u0644\u0632\u0651\u064f\u0628\u064f\u0631\u0650","translation":"\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u0432\u0430\u0448\u0438 \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0435 \u0432\u0435\u0440\u0443 \u043b\u0443\u0447\u0448\u0435, \u0447\u0435\u043c \u043e\u043d\u0438? \u0418\u043b\u0438 \u0436\u0435 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0432 \u041f\u0438\u0441\u0430\u043d\u0438\u044f\u0445 \u0437\u0430\u043f\u0438\u0441\u044c \u043e\u0431 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0438?","footnotes":""},{"id":"4890","sura":"54","aya":"44","arabic_text":"\u0623\u064e\u0645\u06e1 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0646\u064e\u062d\u06e1\u0646\u064f \u062c\u064e\u0645\u0650\u064a\u0639\u065e \u0645\u0651\u064f\u0646\u062a\u064e\u0635\u0650\u0631\u065e","translation":"\u0418\u043b\u0438 \u0436\u0435 \u043e\u043d\u0438 \u0441\u043a\u0430\u0436\u0443\u0442: \u00ab\u041c\u044b \u2014 \u0441\u043f\u043b\u043e\u0447\u0451\u043d\u043d\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430, \u0438 \u043c\u044b \u043e\u0434\u0435\u0440\u0436\u0438\u043c \u043f\u043e\u0431\u0435\u0434\u0443\u00bb?","footnotes":""},{"id":"4891","sura":"54","aya":"45","arabic_text":"\u0633\u064e\u064a\u064f\u0647\u06e1\u0632\u064e\u0645\u064f \u0671\u0644\u06e1\u062c\u064e\u0645\u06e1\u0639\u064f \u0648\u064e\u064a\u064f\u0648\u064e\u0644\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u062f\u0651\u064f\u0628\u064f\u0631\u064e","translation":"\u0421\u0431\u043e\u0440\u0438\u0449\u0435 \u044d\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u0432\u0435\u0440\u0436\u0435\u043d\u043e, \u0438 \u043e\u043d\u0438 \u043e\u0431\u0440\u0430\u0442\u044f\u0442\u0441\u044f \u0432\u0441\u043f\u044f\u0442\u044c.","footnotes":""},{"id":"4892","sura":"54","aya":"46","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u064f \u0645\u064e\u0648\u06e1\u0639\u0650\u062f\u064f\u0647\u064f\u0645\u06e1 \u0648\u064e\u0671\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u064f \u0623\u064e\u062f\u06e1\u0647\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0645\u064e\u0631\u0651\u064f","translation":"\u041d\u0435\u0442, \u043d\u0430\u043f\u0440\u043e\u0442\u0438\u0432! \u0427\u0430\u0441 \u2014 \u0438\u0445 \u0441\u0440\u043e\u043a, \u0438 \u0427\u0430\u0441 \u044d\u0442\u043e\u0442 \u2014 \u0441\u0442\u0440\u0430\u0448\u043d\u0435\u0435 \u0438 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0435\u0435.","footnotes":""},{"id":"4893","sura":"54","aya":"47","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0636\u064e\u0644\u064e\u0670\u0644\u0656 \u0648\u064e\u0633\u064f\u0639\u064f\u0631\u0656","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u044b\u0435 \u2014 \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0438 \u0438 \u0431\u0435\u0437\u0443\u043c\u0438\u0438.","footnotes":""},{"id":"4894","sura":"54","aya":"48","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064f\u0633\u06e1\u062d\u064e\u0628\u064f\u0648\u0646\u064e \u0641\u0650\u064a \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0639\u064e\u0644\u064e\u0649\u0670 \u0648\u064f\u062c\u064f\u0648\u0647\u0650\u0647\u0650\u0645\u06e1 \u0630\u064f\u0648\u0642\u064f\u0648\u0627\u0652 \u0645\u064e\u0633\u0651\u064e \u0633\u064e\u0642\u064e\u0631\u064e","translation":"\u0412 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0432\u043b\u0430\u0447\u0438\u043c\u044b \u0432 \u0430\u0434\u0441\u043a\u0438\u0439 \u043e\u0433\u043e\u043d\u044c \u043d\u0430 \u0441\u0432\u043e\u0438\u0445 \u043b\u0438\u0446\u0430\u0445: \u00ab\u0412\u043a\u0443\u0441\u0438\u0442\u0435 \u0436\u0435 \u043f\u0440\u0438\u043a\u043e\u0441\u043d\u043e\u0432\u0435\u043d\u0438\u0435 \u041f\u0440\u0435\u0438\u0441\u043f\u043e\u0434\u043d\u0435\u0439!\u00bb","footnotes":""},{"id":"4895","sura":"54","aya":"49","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064f\u0644\u0651\u064e \u0634\u064e\u064a\u06e1\u0621\u064d \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f \u0628\u0650\u0642\u064e\u062f\u064e\u0631\u0656","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0432\u0441\u0451 \u0441\u0443\u0449\u0435\u0435 \u041c\u044b \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u043b\u0438 \u043f\u043e \u043f\u0440\u0435\u0434\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e.","footnotes":""},{"id":"4896","sura":"54","aya":"50","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1\u0631\u064f\u0646\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0648\u064e\u0670\u062d\u0650\u062f\u064e\u0629\u065e \u0643\u064e\u0644\u064e\u0645\u06e1\u062d\u0650\u06ed \u0628\u0650\u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u0650","translation":"\u0418 \u043f\u043e\u0432\u0435\u043b\u0435\u043d\u0438\u0435 \u041d\u0430\u0448\u0435 \u2014 \u043d\u0435 \u0438\u043d\u0430\u0447\u0435 \u043a\u0430\u043a \u043e\u0434\u043d\u043e [\u043b\u0438\u0448\u044c \u0441\u043b\u043e\u0432\u043e], \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u0438\u044e \u043e\u043a\u0430.","footnotes":""},{"id":"4897","sura":"54","aya":"51","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0634\u06e1\u064a\u064e\u0627\u0639\u064e\u0643\u064f\u0645\u06e1 \u0641\u064e\u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u0656","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u041c\u044b \u043f\u043e\u0433\u0443\u0431\u0438\u043b\u0438 \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0445 \u0432\u0430\u043c. \u0418 \u0435\u0441\u0442\u044c \u043b\u0438 \u0442\u043e\u0442, \u043a\u0442\u043e \u0432\u043d\u0435\u0