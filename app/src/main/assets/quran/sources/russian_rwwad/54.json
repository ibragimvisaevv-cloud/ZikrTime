043c\u0438\u043d\u0430\u043d\u0438\u044e?","footnotes":""},{"id":"4862","sura":"54","aya":"16","arabic_text":"\u0641\u064e\u0643\u064e\u064a\u06e1\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"\u0418 \u043a\u0430\u043a\u043e\u0432\u044b \u0436\u0435 \u0431\u044b\u043b\u0438 \u041c\u043e\u0451 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f!","footnotes":""},{"id":"4863","sura":"54","aya":"17","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u064a\u064e\u0633\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e \u0644\u0650\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u0650 \u0641\u064e\u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u0656","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u041c\u044b \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u043b\u0438 \u041a\u043e\u0440\u0430\u043d \u0434\u043b\u044f \u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f. \u0418 \u0435\u0441\u0442\u044c \u043b\u0438 \u0442\u043e\u0442, \u043a\u0442\u043e \u0432\u043d\u0435\u043c\u043b\u0435\u0442 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044e?","footnotes":""},{"id":"4864","sura":"54","aya":"18","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u06e1 \u0639\u064e\u0627\u062f\u065e \u0641\u064e\u0643\u064e\u064a\u06e1\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"\u041f\u043b\u0435\u043c\u044f \u2018\u0430\u0434 \u0441\u043e\u0447\u043b\u043e \u0438\u0441\u0442\u0438\u043d\u0443 \u043b\u043e\u0436\u044c\u044e. \u0418 \u043a\u0430\u043a\u043e\u0432\u044b \u043