{"result":[{"id":"5105","sura":"58","aya":"1","arabic_text":"\u0642\u064e\u062f\u06e1 \u0633\u064e\u0645\u0650\u0639\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0642\u064e\u0648\u06e1\u0644\u064e \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064f\u062c\u064e\u0670\u062f\u0650\u0644\u064f\u0643\u064e \u0641\u0650\u064a \u0632\u064e\u0648\u06e1\u062c\u0650\u0647\u064e\u0627 \u0648\u064e\u062a\u064e\u0634\u06e1\u062a\u064e\u0643\u0650\u064a\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u064a\u064e\u0633\u06e1\u0645\u064e\u0639\u064f \u062a\u064e\u062d\u064e\u0627\u0648\u064f\u0631\u064e\u0643\u064f\u0645\u064e\u0627\u0653\u06da \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0633\u064e\u0645\u0650\u064a\u0639\u064f\u06e2 \u0628\u064e\u0635\u0650\u064a\u0631\u064c","translation":"\u0414\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0410\u043b\u043b\u0430\u0445 \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0441\u043b\u043e\u0432\u0430 \u0442\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0435\u0440\u0435\u043a\u0430\u043b\u0430\u0441\u044c \u0441 \u0442\u043e\u0431\u043e\u0439 \u043e \u0441\u0432\u043e\u0451\u043c \u043c\u0443\u0436\u0435 \u0438 \u0436\u0430\u043b\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0410\u043b\u043b\u0430\u0445\u0443, \u0442\u043e\u0433\u0434\u0430 \u043a\u0430\u043a \u0410\u043b\u043b\u0430\u0445 \u0441\u043b\u044b\u0448\u0438\u0442 \u0432\u0430\u0448 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0410\u043b\u043b\u0430\u0445 \u2014 \u0441\u043b\u044b\u0448\u0430\u0449\u0438\u0439, \u0432\u0438\u0434\u044f\u0449\u0438\u0439.","footnotes":""},{"id":"5106","sura":"58","aya":"2","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u0638\u064e\u0670\u0647\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u0650\u0646 \u0646\u0651\u0650\u0633\u064e\u0627\u0653\u0626\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0627 \u0647\u064f\u0646\u0651\u064e \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1\u06d6 \u0625\u0650\u0646\u06e1 \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u064f\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0670\u0653\u0640\u0654\u0650\u064a \u0648\u064e\u0644\u064e\u062f\u06e1\u0646\u064e\u0647\u064f\u0645\u06e1\u06da \u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0645\u064f\u0646\u0643\u064e\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0642\u064e\u0648\u06e1\u0644\u0650 \u0648\u064e\u0632\u064f\u0648\u0631\u0657\u0627\u06da \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0644\u064e\u0639\u064e\u0641\u064f\u0648\u0651\u064c \u063a\u064e\u0641\u064f\u0648\u0631\u065e","translation":"\u0422\u0435 \u0438\u0437 \u0432\u0430\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0431\u044a\u044f\u0432\u043b\u044f\u044e\u0442 \u0441\u0432\u043e\u0438\u0445 \u0436\u0451\u043d [\u0437\u0430\u043f\u0440\u0435\u0442\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0441\u0435\u0431\u044f, \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044f \u0438\u0445 \u0441\u043e] \u0441\u043f\u0438\u043d\u0430\u043c\u0438 \u0441\u0432\u043e\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0435\u0439, \u2014 \u043e\u043d\u0438 \u043d\u0435 \u043c\u0430\u0442\u0435\u0440\u0438 \u0438\u043c. \u0418\u0445 \u043c\u0430\u0442\u0435\u0440\u0438 \u2014 \u043b\u0438\u0448\u044c \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u043e\u0434\u0438\u043b\u0438 \u0438\u0445. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u043e\u043d\u0438 \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0441\u044f\u0442 \u043f\u0440\u0435\u0434\u043e\u0441\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0441\u043b\u043e\u0432\u043e \u0438 \u043b\u043e\u0436\u044c. \u0418, \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0410\u043b\u043b\u0430\u0445 \u2014 \u0441\u043d\u0438\u0441\u0445\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439, \u043f\u0440\u043e\u0449\u0430\u044e\u0449\u0438\u0439.","footnotes":""},{"id":"5107","sura":"58","aya":"3","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u0638\u064e\u0670\u0647\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0646\u0651\u0650\u0633\u064e\u0627\u0653\u0626\u0650\u0647\u0650\u0645\u06e1 \u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0639\u064f\u0648\u062f\u064f\u0648\u0646\u064e \u0644\u0650\u0645\u064e\u0627 \u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0641\u064e\u062a\u064e\u062d\u06e1\u0631\u0650\u064a\u0631\u064f \u0631\u064e\u0642\u064e\u0628\u064e\u0629\u0656 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0645\u064e\u0627\u0653\u0633\u0651\u064e\u0627\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u06e1 \u062a\u064f\u0648\u0639\u064e\u0638\u064f\u0648\u0646\u064e \u0628\u0650\u0647\u0650\u06e6\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u062e\u064e\u0628\u0650\u064a\u0631\u065e","translation":"\u0410 \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0431\u044a\u044f\u0432\u043b\u044f\u044e\u0442 \u0441\u0432\u043e\u0438\u0445 \u0436\u0451\u043d [\u0437\u0430\u043f\u0440\u0435\u0442\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0441\u0435\u0431\u044f, \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044f \u0438\u0445 \u0441\u043e] \u0441\u043f\u0438\u043d\u0430\u043c\u0438 \u0441\u0432\u043e\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0435\u0439, \u0430 \u0437\u0430\u0442\u0435\u043c \u043e\u0442\u0441\u0442\u0443\u043f\u0430\u044e\u0442\u0441\u044f \u043e\u0442 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0438, \u0434\u043e\u043b\u0436\u043d\u044b \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u044c \u0440\u0430\u0431\u0430 \u043f\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043c \u043e\u043d\u0438 \u043a\u043e\u0441\u043d\u0443\u0442\u0441\u044f \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u042d\u0442\u0438\u043c \u0432\u0430\u0441 \u0443\u0432\u0435\u0449\u0435\u0432\u0430\u044e\u0442, \u0430 \u0410\u043b\u043b\u0430\u0445 \u2014 \u0441\u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0432\u044b \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0435.","footnotes":""},{"id":"5108","sura":"58","aya":"4","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u062c\u0650\u062f\u06e1 \u0641\u064e\u0635\u0650\u064a\u064e\u0627\u0645\u064f \u0634\u064e\u0647\u06e1\u0631\u064e\u064a\u06e1\u0646\u0650 \u0645\u064f\u062a\u064e\u062a\u064e\u0627\u0628\u0650\u0639\u064e\u064a\u06e1\u0646\u0650 \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0645\u064e\u0627\u0653\u0633\u0651\u064e\u0627\u06d6 \u0641\u064e\u0645\u064e\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u0633\u06e1\u062a\u064e\u0637\u0650\u0639\u06e1 \u0641\u064e\u0625\u0650\u0637\u06e1\u0639\u064e\u0627\u0645\u064f \u0633\u0650\u062a\u0651\u0650\u064a\u0646\u064e \u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0657\u0627\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0644\u0650\u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6\u06da \u0648\u064e\u062a\u0650\u0644\u06e1\u0643\u064e \u062d\u064f\u062f\u064f\u0648\u062f\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06d7 \u0648\u064e\u0644\u0650\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u064c \u0623\u064e\u0644\u0650\u064a\u0645\u064c","translation":"\u0410 \u043a\u0442\u043e \u043d\u0435 \u043d\u0430\u0439\u0434\u0451\u0442 [\u0440\u0430\u0431\u0430], \u0442\u043e\u043c\u0443 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u043e\u0441\u0442\u0438\u0442\u044c\u0441\u044f \u0434\u0432\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0434\u0440\u044f\u0434 \u043f\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043c \u043e\u043d\u0438 \u043a\u043e\u0441\u043d\u0443\u0442\u0441\u044f \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u0410 \u043a\u0442\u043e \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442, \u0442\u043e\u043c\u0443 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043d\u0430\u043a\u043e\u0440\u043c\u0438\u0442\u044c \u0448\u0435\u0441\u0442\u044c\u0434\u0435\u0441\u044f\u0442 \u0431\u0435\u0434\u043d\u044f\u043a\u043e\u0432. \u042d\u0442\u043e \u2014 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0432\u044b \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438 \u0432 \u0410\u043b\u043b\u0430\u0445\u0430 \u0438 \u0415\u0433\u043e \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u0430. \u0422\u0430\u043a\u043e\u0432\u044b \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0410\u043b\u043b\u0430\u0445\u0430. \u0410 \u0434\u043b\u044f \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0445 \u0432\u0435\u0440\u0443 \u2014 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435.","footnotes":""},{"id":"5109","sura":"58","aya":"5","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u062d\u064e\u0627\u0653\u062f\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f\u06e5 \u0643\u064f\u0628\u0650\u062a\u064f\u0648\u0627\u0652 \u0643\u064e\u0645\u064e\u0627 \u0643\u064f\u0628\u0650\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650\u0647\u0650\u0645\u06e1\u06da \u0648\u064e\u0642\u064e\u062f\u06e1 \u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u06ed \u0628\u064e\u064a\u0651\u0650\u0646\u064e\u0670\u062a\u0656\u06da \u0648\u064e\u0644\u0650\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u065e \u0645\u0651\u064f\u0647\u0650\u064a\u0646\u065e","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0440\u0430\u0436\u0434\u0443\u044e\u0442 \u0441 \u0410\u043b\u043b\u0430\u0445\u043e\u043c \u0438 \u0415\u0433\u043e \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u043e\u043c, \u0431\u0443\u0434\u0443\u0442 \u043f\u043e\u0432\u0435\u0440\u0436\u0435\u043d\u044b, \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0442\u043e\u043c\u0443, \u043a\u0430\u043a \u0431\u044b\u043b\u0438 \u043f\u043e\u0432\u0435\u0440\u0436\u0435\u043d\u044b \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u0434\u043e \u043d\u0438\u0445. \u041c\u044b \u0443\u0436\u0435 \u043d\u0438\u0441\u043f\u043e\u0441\u043b\u0430\u043b\u0438 \u044f\u0441\u043d\u044b\u0435 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u044f. \u0410 \u0434\u043b\u044f \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0445 \u0432\u0435\u0440\u0443 \u2014 \u0443\u043d\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435.","footnotes":""},{"id":"5110","sura":"58","aya":"6","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0628\u06e1\u0639\u064e\u062b\u064f\u0647\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u062c\u064e\u0645\u0650\u064a\u0639\u0657\u0627 \u0641\u064e\u064a\u064f\u0646\u064e\u0628\u0651\u0650\u0626\u064f\u0647\u064f\u0645 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0653\u0627\u0652\u06da \u0623\u064e\u062d\u06e1\u0635\u064e\u0649\u0670\u0647\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0648\u064e\u0646\u064e\u0633\u064f\u0648\u0647\u064f\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u0656 \u0634\u064e\u0647\u0650\u064a\u062f\u064c","translation":"\u0412 \u0442\u043e\u0442 \u0414\u0435\u043d\u044c, \u043a\u043e\u0433\u0434\u0430 \u0410\u043b\u043b\u0430\u0445 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0438\u0442 \u0438\u0445 \u0432\u0441\u0435\u0445, \u041e\u043d \u043f\u043e\u0432\u0435\u0434\u0430\u0435\u0442 \u0438\u043c \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b\u0438. \u0410\u043b\u043b\u0430\u0445 \u0438\u0441\u0447\u0438\u0441\u043b\u0438\u043b \u044d\u0442\u043e, \u0430 \u043e\u043d\u0438 \u0437\u0430\u0431\u044b\u043b\u0438. \u0410\u043b\u043b\u0430\u0445 \u2014 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c \u043d\u0430\u0434 \u0432\u0441\u0435\u043c \u0441\u0443\u0449\u0438\u043c.","footnotes":""},{"id":"5111","sura":"58","aya":"7","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u062a\u064e\u0631\u064e \u0623\u064e\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06d6 \u0645\u064e\u0627 \u064a\u064e\u0643\u064f\u0648\u0646\u064f \u0645\u0650\u0646 \u0646\u0651\u064e\u062c\u06e1\u0648\u064e\u0649\u0670 \u062b\u064e\u0644\u064e\u0670\u062b\u064e\u0629\u064d \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0631\u064e\u0627\u0628\u0650\u0639\u064f\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062e\u064e\u0645\u06e1\u0633\u064e\u0629\u064d \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0633\u064e\u0627\u062f\u0650\u0633\u064f\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0646\u064e\u0649\u0670 \u0645\u0650\u0646 \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u0643\u06e1\u062b\u064e\u0631\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0645\u064e\u0639\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u064a\u06e1\u0646\u064e \u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652\u06d6 \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0646\u064e\u0628\u0651\u0650\u0626\u064f\u0647\u064f\u0645 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u06e1\u0642\u0650\u064a\u064e\u0670\u0645\u064e\u0629\u0650\u06da \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0628\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u064d \u0639\u064e\u0644\u0650\u064a\u0645\u064c","translation":"\u0420\u0430\u0437\u0432\u0435 \u0442\u044b \u043d\u0435 \u0432\u0438\u0434\u0435\u043b, \u0447\u0442\u043e \u0410\u043b\u043b\u0430\u0445 \u0437\u043d\u0430\u0435\u0442 \u0432\u0441\u0451, \u0447\u0442\u043e \u0432 \u043d\u0435\u0431\u0435\u0441\u0430\u0445, \u0438 \u0432\u0441\u0451, \u0447\u0442\u043e \u043d\u0430 \u0437\u0435\u043c\u043b\u0435? \u041d\u0435 \u0431\u044b\u0432\u0430\u0435\u0442 \u0442\u0430\u0439\u043d\u043e\u0439 \u0431\u0435\u0441\u0435\u0434\u044b \u0442\u0440\u043e\u0438\u0445, \u0447\u0442\u043e\u0431\u044b \u041e\u043d \u043d\u0435 \u0431\u044b\u043b \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044b\u043c \u0438 \u043f\u044f\u0442\u0435\u0440\u044b\u0445, \u0447\u0442\u043e\u0431\u044b \u041e\u043d \u043d\u0435 \u0431\u044b\u043b \u0448\u0435\u0441\u0442\u044b\u043c. \u0418 \u0431\u0443\u0434\u044c \u0438\u0445 \u043c\u0435\u043d\u044c\u0448\u0435 \u0438\u043b\u0438 \u0431\u043e\u043b\u044c\u0448\u0435, \u041e\u043d \u0432\u0441\u0435\u0433\u0434\u0430 \u0441 \u043d\u0438\u043c\u0438, \u0433\u0434\u0435 \u0431\u044b \u043e\u043d\u0438 \u043d\u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0438\u0441\u044c. \u0410 \u0437\u0430\u0442\u0435\u043c \u041e\u043d \u043f\u043e\u0432\u0435\u0434\u0430\u0435\u0442 \u0438\u043c \u0432 \u0414\u0435\u043d\u044c \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0435\u043d\u0438\u044f \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u043b\u0438. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0410\u043b\u043b\u0430\u0445 \u2014 \u0437\u043d\u0430\u044e\u0449\u0438\u0439 \u043e\u0431\u043e \u0432\u0441\u0451\u043c \u0441\u0443\u0449\u0435\u043c.","footnotes":""},{"id":"5112","sura":"58","aya":"8","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u062a\u064e\u0631\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0646\u064f\u0647\u064f\u0648\u0627\u0652 \u0639\u064e\u0646\u0650 \u0671\u0644\u0646\u0651\u064e\u062c\u06e1\u0648\u064e\u0649\u0670 \u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0639\u064f\u0648\u062f\u064f\u0648\u0646\u064e \u0644\u0650\u0645\u064e\u0627 \u0646\u064f\u0647\u064f\u0648\u0627\u0652 \u0639\u064e\u0646\u06e1\u0647\u064f \u0648\u064e\u064a\u064e\u062a\u064e\u0646\u064e\u0670\u062c\u064e\u0648\u06e1\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0639\u064f\u062f\u06e1\u0648\u064e\u0670\u0646\u0650 \u0648\u064e\u0645\u064e\u0639\u06e1\u0635\u0650\u064a\u064e\u062a\u0650 \u0671\u0644\u0631\u0651\u064e\u0633\u064f\u0648\u0644\u0650\u06d6 \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064f\u0648\u0643\u064e \u062d\u064e\u064a\u0651\u064e\u0648\u06e1\u0643\u064e \u0628\u0650\u0645\u064e\u0627 \u0644\u064e\u0645\u06e1 \u064a\u064f\u062d\u064e\u064a\u0651\u0650\u0643\u064e \u0628\u0650\u0647\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0653 \u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0647\u0650\u0645\u06e1 \u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f\u0646\u064e\u0627 \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u0646\u064e\u0642\u064f\u0648\u0644\u064f\u06da \u062d\u064e\u0633\u06e1\u0628\u064f\u0647\u064f\u0645\u06e1 \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064f \u064a\u064e\u0635\u06e1\u0644\u064e\u0648\u06e1\u0646\u064e\u0647\u064e\u0627\u06d6 \u0641\u064e\u0628\u0650\u0626\u06e1\u0633\u064e \u0671\u0644\u06e1\u0645\u064e\u0635\u0650\u064a\u0631\u064f","translation":"\u0420\u0430\u0437\u0432\u0435 \u0442\u044b \u043d\u0435 \u0432\u0438\u0434\u0435\u043b \u0442\u0435\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0431\u044b\u043b\u0438 \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u044b \u0442\u0430\u0439\u043d\u044b\u0435 \u0431\u0435\u0441\u0435\u0434\u044b, \u043d\u043e \u0437\u0430\u0442\u0435\u043c \u043e\u043d\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044e\u0442\u0441\u044f \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0438\u043c \u0431\u044b\u043b\u043e \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043e? \u041e\u043d\u0438 \u0432\u0435\u0434\u0443\u0442 \u0442\u0430\u0439\u043d\u044b\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u044b \u043e \u0433\u0440\u0435\u0445\u0435, \u0432\u0440\u0430\u0436\u0434\u0435 \u0438 \u043e\u0441\u043b\u0443\u0448\u0430\u043d\u0438\u0438 \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u0430. \u041a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442 \u043a \u0442\u0435\u0431\u0435, \u043e\u043d\u0438 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0442\u0435\u0431\u044f [\u0441\u043b\u043e\u0432\u0430\u043c\u0438], \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0442\u0435\u0431\u044f \u0410\u043b\u043b\u0430\u0445, \u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043f\u0440\u043e \u0441\u0435\u0431\u044f: \u00ab\u041f\u043e\u0447\u0435\u043c\u0443 \u0431\u044b \u0410\u043b\u043b\u0430\u0445\u0443 \u043d\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430\u0441 \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c?\u00bb \u0414\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0438\u043c \u0413\u0435\u0435\u043d\u043d\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0433\u043e\u0440\u0435\u0442\u044c! \u0418 \u0441\u043a\u043e\u043b\u044c \u0443\u0436\u0430\u0441\u0435\u043d \u044d\u0442\u043e\u0442 \u0438\u0441\u0445\u043e\u0434!","footnotes":""},{"id":"5113","sura":"58","aya":"9","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0646\u064e\u0670\u062c\u064e\u064a\u06e1\u062a\u064f\u0645\u06e1 \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u062a\u064e\u0646\u064e\u0670\u062c\u064e\u0648\u06e1\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0639\u064f\u062f\u06e1\u0648\u064e\u0670\u0646\u0650 \u0648\u064e\u0645\u064e\u0639\u06e1\u0635\u0650\u064a\u064e\u062a\u0650 \u0671\u0644\u0631\u0651\u064e\u0633\u064f\u0648\u0644\u0650 \u0648\u064e\u062a\u064e\u0646\u064e\u0670\u062c\u064e\u0648\u06e1\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u0628\u0650\u0631\u0651\u0650 \u0648\u064e\u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670\u06d6 \u0648\u064e\u0671\u062a\u0651\u064e\u0642\u064f\u0648\u0627\u0652 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0653 \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u062a\u064f\u062d\u06e1\u0634\u064e\u0631\u064f\u0648\u0646\u064e","translation":"\u041e \u0432\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438! \u041a\u043e\u0433\u0434\u0430 \u0432\u044b \u0432\u0435\u0434\u0451\u0442\u0435 \u0442\u0430\u0439\u043d\u0443\u044e \u0431\u0435\u0441\u0435\u0434\u0443, \u043d\u0435 \u0431\u0435\u0441\u0435\u0434\u0443\u0439\u0442\u0435 \u043e \u0433\u0440\u0435\u0445\u0435, \u0432\u0440\u0430\u0436\u0434\u0435 \u0438 \u043e\u0441\u043b\u0443\u0448\u0430\u043d\u0438\u0438 \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u0430, \u0430 \u0431\u0435\u0441\u0435\u0434\u0443\u0439\u0442\u0435 \u043e \u0431\u043b\u0430\u0433\u043e\u0447\u0435\u0441\u0442\u0438\u0438 \u0438 \u0431\u043e\u0433\u043e\u0431\u043e\u044f\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u0438. \u0411\u043e\u0439\u0442\u0435\u0441\u044c \u0410\u043b\u043b\u0430\u0445\u0430, \u043a \u041a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0431\u0443\u0434\u0435\u0442\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u044b.","footnotes":""},{"id":"5114","sura":"58","aya":"10","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u062c\u06e1\u0648\u064e\u0649\u0670 \u0645\u0650\u0646\u064e \u0671\u0644\u0634\u0651\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u0650 \u0644\u0650\u064a\u064e\u062d\u06e1\u0632\u064f\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0628\u0650\u0636\u064e\u0627\u0653\u0631\u0651\u0650\u0647\u0650\u0645\u06e1 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0625\u0650\u0630\u06e1\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06da \u0648\u064e\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0644\u06e1\u064a\u064e\u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u0650 \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u0430\u0439\u043d\u0430\u044f \u0431\u0435\u0441\u0435\u0434\u0430 \u2014 \u043b\u0438\u0448\u044c \u043e\u0442 \u0448\u0430\u0439\u0442\u0430\u043d\u0430, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0435\u0447\u0430\u043b\u0438\u043b\u0438\u0441\u044c \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438. \u041d\u043e \u043e\u043d \u043d\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u0438\u0442 \u0438\u043c \u0432\u0440\u0435\u0434\u0430 \u043d\u0438 \u0432 \u0447\u0451\u043c, \u043a\u0440\u043e\u043c\u0435 \u043a\u0430\u043a \u0441 \u0434\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u0438\u044f \u0410\u043b\u043b\u0430\u0445\u0430. \u0418 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0410\u043b\u043b\u0430\u0445\u0430 \u043f\u0443\u0441\u0442\u044c \u0443\u043f\u043e\u0432\u0430\u044e\u0442 \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0435.","footnotes":""},{"id":"5115","sura":"58","aya":"11","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u0641\u064e\u0633\u0651\u064e\u062d\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u0671\u0644\u06e1\u0645\u064e\u062c\u064e\u0670\u0644\u0650\u0633\u0650 \u0641\u064e\u0671\u0641\u06e1\u0633\u064e\u062d\u064f\u0648\u0627\u0652 \u064a\u064e\u0641\u06e1\u0633\u064e\u062d\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0671\u0646\u0634\u064f\u0632\u064f\u0648\u0627\u0652 \u0641\u064e\u0671\u0646\u0634\u064f\u0632\u064f\u0648\u0627\u0652 \u064a\u064e\u0631\u06e1\u0641\u064e\u0639\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u064e \u062f\u064e\u0631\u064e\u062c\u064e\u0670\u062a\u0656\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u062e\u064e\u0628\u0650\u064a\u0631\u065e","translation":"\u041e \u0432\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438! \u041a\u043e\u0433\u0434\u0430 \u0432\u0430\u043c \u0433\u043e\u0432\u043e\u0440\u044f\u0442: \u00ab\u0414\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0440 \u043d\u0430 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u044f\u0445\u00bb, \u2014 \u0442\u043e \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0440, \u0438 \u0410\u043b\u043b\u0430\u0445 \u0434\u0430\u0441\u0442 \u043f\u0440\u043e\u0441\u0442\u043e\u0440 \u0434\u043b\u044f \u0432\u0430\u0441. \u0410 \u043a\u043e\u0433\u0434\u0430 \u0432\u0430\u043c \u0433\u043e\u0432\u043e\u0440\u044f\u0442: \u00ab\u0412\u0441\u0442\u0430\u043d\u044c\u0442\u0435\u00bb, \u2014 \u0442\u043e \u0432\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435. \u0410\u043b\u043b\u0430\u0445 \u0432\u043e\u0437\u0432\u044b\u0441\u0438\u0442 \u043f\u043e \u0441\u0442\u0435\u043f\u0435\u043d\u044f\u043c \u0442\u0435\u0445 \u0438\u0437 \u0432\u0430\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438, \u0438 \u0442\u0435\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0434\u0430\u0440\u043e\u0432\u0430\u043d\u043e \u0437\u043d\u0430\u043d\u0438\u0435. \u0410\u043b\u043b\u0430\u0445 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0432\u044b \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0435, \u0441\u0432\u0435\u0434\u0443\u0449\u0438\u0439.","footnotes":""},{"id":"5116","sura":"58","aya":"12","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0630\u064e\u0627 \u0646\u064e\u0670\u062c\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0631\u0651\u064e\u0633\u064f\u0648\u0644\u064e \u0641\u064e\u0642\u064e\u062f\u0651\u0650\u0645\u064f\u0648\u0627\u0652 \u0628\u064e\u064a\u06e1\u0646\u064e \u064a\u064e\u062f\u064e\u064a\u06e1 \u0646\u064e\u062c\u06e1\u0648\u064e\u0649\u0670\u0643\u064f\u0645\u06e1 \u0635\u064e\u062f\u064e\u0642\u064e\u0629\u0657\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u062e\u064e\u064a\u06e1\u0631\u065e \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0623\u064e\u0637\u06e1\u0647\u064e\u0631\u064f\u06da \u0641\u064e\u0625\u0650\u0646 \u0644\u0651\u064e\u0645\u06e1 \u062a\u064e\u062c\u0650\u062f\u064f\u0648\u0627\u0652 \u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u063a\u064e\u0641\u064f\u0648\u0631\u065e \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064c","translation":"\u041e \u0432\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438! \u041a\u043e\u0433\u0434\u0430 \u0432\u044b \u0432\u0435\u0434\u0451\u0442\u0435 \u0442\u0430\u0439\u043d\u0443\u044e \u0431\u0435\u0441\u0435\u0434\u0443 \u0441 \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u043e\u043c, \u0442\u043e \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u044f\u0439\u0442\u0435 \u0441\u0432\u043e\u044e \u0431\u0435\u0441\u0435\u0434\u0443 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\u043c. \u042d\u0442\u043e \u2014 \u043b\u0443\u0447\u0448\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0438 \u0447\u0438\u0449\u0435. \u0410 \u0435\u0441\u043b\u0438 \u0432\u044b \u043d\u0435 \u043d\u0430\u0439\u0434\u0451\u0442\u0435 [\u0447\u0442\u043e \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u0442\u044c], \u0442\u043e \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0410\u043b\u043b\u0430\u0445 \u2014 \u043f\u0440\u043e\u0449\u0430\u044e\u0449\u0438\u0439, \u043c\u0438\u043b\u0443\u044e\u0449\u0438\u0439.","footnotes":""},{"id":"5117","sura":"58","aya":"13","arabic_text":"\u0621\u064e\u0623\u064e\u0634\u06e1\u0641\u064e\u0642\u06e1\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646 \u062a\u064f\u0642\u064e\u062f\u0651\u0650\u0645\u064f\u0648\u0627\u0652 \u0628\u064e\u064a\u06e1\u0646\u064e \u064a\u064e\u062f\u064e\u064a\u06e1 \u0646\u064e\u062c\u06e1\u0648\u064e\u0649\u0670\u0643\u064f\u0645\u06e1 \u0635\u064e\u062f\u064e\u0642\u064e\u0670\u062a\u0656\u06da \u0641\u064e\u0625\u0650\u0630\u06e1 \u0644\u064e\u0645\u06e1 \u062a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u06e1 \u0641\u064e\u0623\u064e\u0642\u0650\u064a\u0645\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u064e \u0648\u064e\u0621\u064e\u0627\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u0632\u0651\u064e\u0643\u064e\u0648\u0670\u0629\u064e \u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0627\u0652 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f\u06e5\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u062e\u064e\u0628\u0650\u064a\u0631\u064f\u06e2 \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u0432\u044b \u043f\u043e\u0431\u043e\u044f\u043b\u0438\u0441\u044c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u044c \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0441\u0432\u043e\u044e \u0442\u0430\u0439\u043d\u0443\u044e \u0431\u0435\u0441\u0435\u0434\u0443? \u0410 \u0440\u0430\u0437 \u0432\u044b \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u044d\u0442\u043e\u0433\u043e \u0438 \u0410\u043b\u043b\u0430\u0445 \u043f\u0440\u0438\u043d\u044f\u043b \u0432\u0430\u0448\u0435 \u043f\u043e\u043a\u0430\u044f\u043d\u0438\u0435, \u0442\u043e \u0432\u044b\u0441\u0442\u0430\u0438\u0432\u0430\u0439\u0442\u0435 \u043c\u043e\u043b\u0438\u0442\u0432\u0443, \u0432\u044b\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u0437\u0430\u043a\u044f\u0442 \u0438 \u043f\u043e\u0432\u0438\u043d\u0443\u0439\u0442\u0435\u0441\u044c \u0410\u043b\u043b\u0430\u0445\u0443 \u0438 \u0415\u0433\u043e \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u0443. \u0410 \u0410\u043b\u043b\u0430\u0445 \u2014 \u0441\u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0432\u044b \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0435.","footnotes":""},{"id":"5118","sura":"58","aya":"14","arabic_text":"\u06de\u00a0\u0623\u064e\u0644\u064e\u0645\u06e1 \u062a\u064e\u0631\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0648\u06e1\u0627\u0652 \u0642\u064e\u0648\u06e1\u0645\u064b\u0627 \u063a\u064e\u0636\u0650\u0628\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645 \u0645\u0651\u064e\u0627 \u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u064a\u064e\u062d\u06e1\u0644\u0650\u0641\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0630\u0650\u0628\u0650 \u0648\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u0420\u0430\u0437\u0432\u0435 \u0442\u044b \u043d\u0435 \u0432\u0438\u0434\u0435\u043b \u0442\u0435\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0437\u044f\u043b\u0438 \u0441\u0435\u0431\u0435 \u043f\u043e\u043a\u0440\u043e\u0432\u0438\u0442\u0435\u043b\u044f\u043c\u0438 \u043d\u0430\u0440\u043e\u0434, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043b\u0441\u044f \u0410\u043b\u043b\u0430\u0445? \u041e\u043d\u0438 \u2014 \u043d\u0435 \u0438\u0437 \u0432\u0430\u0441 \u0438 \u043d\u0435 \u0438\u0437 \u043d\u0438\u0445, \u0438 \u043e\u043d\u0438 \u043a\u043b\u044f\u043d\u0443\u0442\u0441\u044f \u0432\u043e \u043b\u0436\u0438, \u0437\u043d\u0430\u044f \u044d\u0442\u043e.","footnotes":""},{"id":"5119","sura":"58","aya":"15","arabic_text":"\u0623\u064e\u0639\u064e\u062f\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0657\u0627 \u0634\u064e\u062f\u0650\u064a\u062f\u064b\u0627\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0633\u064e\u0627\u0653\u0621\u064e \u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u0410\u043b\u043b\u0430\u0445 \u0443\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0434\u043b\u044f \u043d\u0438\u0445 \u0441\u0443\u0440\u043e\u0432\u043e\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0441\u043a\u0432\u0435\u0440\u043d\u043e \u0442\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u043b\u0438.","footnotes":""},{"id":"5120","sura":"58","aya":"16","arabic_text":"\u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u064a\u06e1\u0645\u064e\u0670\u0646\u064e\u0647\u064f\u0645\u06e1 \u062c\u064f\u0646\u0651\u064e\u0629\u0657 \u0641\u064e\u0635\u064e\u062f\u0651\u064f\u0648\u0627\u0652 \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u065e \u0645\u0651\u064f\u0647\u0650\u064a\u0646\u065e","translation":"\u041e\u043d\u0438 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0441\u0432\u043e\u0438 \u043a\u043b\u044f\u0442\u0432\u044b \u043f\u0440\u0438\u043a\u0440\u044b\u0442\u0438\u0435\u043c \u0438 \u0442\u0435\u043c \u0441\u0430\u043c\u044b\u043c \u043e\u0442\u0432\u0440\u0430\u0442\u0438\u043b\u0438 [\u043b\u044e\u0434\u0435\u0439] \u043e\u0442 \u043f\u0443\u0442\u0438 \u0410\u043b\u043b\u0430\u0445\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0434\u043b\u044f \u043d\u0438\u0445 \u2014 \u0443\u043d\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435.","footnotes":""},{"id":"5121","sura":"58","aya":"17","arabic_text":"\u0644\u0651\u064e\u0646 \u062a\u064f\u063a\u06e1\u0646\u0650\u064a\u064e \u0639\u064e\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u0644\u064f\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u0648\u06e1\u0644\u064e\u0670\u062f\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627\u06da \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650\u06d6 \u0647\u064f\u0645\u06e1 \u0641\u0650\u064a\u0647\u064e\u0627 \u062e\u064e\u0670\u0644\u0650\u062f\u064f\u0648\u0646\u064e","translation":"\u041d\u0438 \u0438\u0445 \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e, \u043d\u0438 \u0438\u0445 \u0434\u0435\u0442\u0438 \u043d\u0438\u0447\u0435\u043c \u043d\u0435 \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u0438\u043c \u043f\u0440\u0435\u0434 \u0410\u043b\u043b\u0430\u0445\u043e\u043c. \u0422\u0430\u043a\u0438\u0435 \u2014 \u043e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u0438 \u041e\u0433\u043d\u044f, \u0432 \u043d\u0451\u043c \u043e\u043d\u0438 \u043f\u0440\u0435\u0431\u0443\u0434\u0443\u0442 \u0432\u0435\u0447\u043d\u043e.","footnotes":""},{"id":"5122","sura":"58","aya":"18","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0628\u06e1\u0639\u064e\u062b\u064f\u0647\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u062c\u064e\u0645\u0650\u064a\u0639\u0657\u0627 \u0641\u064e\u064a\u064e\u062d\u06e1\u0644\u0650\u0641\u064f\u0648\u0646\u064e \u0644\u064e\u0647\u064f\u06e5 \u0643\u064e\u0645\u064e\u0627 \u064a\u064e\u062d\u06e1\u0644\u0650\u0641\u064f\u0648\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f\u0648\u0646\u064e \u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0634\u064e\u064a\u06e1\u0621\u064d\u06da \u0623\u064e\u0644\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0643\u064e\u0670\u0630\u0650\u0628\u064f\u0648\u0646\u064e","translation":"\u0412 \u0442\u043e\u0442 \u0414\u0435\u043d\u044c, \u043a\u043e\u0433\u0434\u0430 \u0410\u043b\u043b\u0430\u0445 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0438\u0442 \u0438\u0445 \u0432\u0441\u0435\u0445, \u043e\u043d\u0438 \u0441\u0442\u0430\u043d\u0443\u0442 \u043a\u043b\u044f\u0441\u0442\u044c\u0441\u044f \u0415\u043c\u0443, \u043a\u0430\u043a \u043a\u043b\u044f\u043d\u0443\u0442\u0441\u044f \u0432\u0430\u043c, \u043f\u043e\u043b\u0430\u0433\u0430\u044f, \u0447\u0442\u043e \u0443 \u043d\u0438\u0445 \u0435\u0441\u0442\u044c [\u043a\u0430\u043a\u043e\u0435-\u0442\u043e] \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435. \u0417\u043d\u0430\u0439\u0442\u0435 \u0436\u0435: \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u043e\u043d\u0438 \u0438 \u0435\u0441\u0442\u044c \u043b\u0436\u0435\u0446\u044b.","footnotes":""},{"id":"5123","sura":"58","aya":"19","arabic_text":"\u0671\u0633\u06e1\u062a\u064e\u062d\u06e1\u0648\u064e\u0630\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u0634\u0651\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u064f \u0641\u064e\u0623\u064e\u0646\u0633\u064e\u0649\u0670\u0647\u064f\u0645\u06e1 \u0630\u0650\u0643\u06e1\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06da \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u062d\u0650\u0632\u06e1\u0628\u064f \u0671\u0644\u0634\u0651\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u0650\u06da \u0623\u064e\u0644\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e \u062d\u0650\u0632\u06e1\u0628\u064e \u0671\u0644\u0634\u0651\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u0650 \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u062e\u064e\u0670\u0633\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u0428\u0430\u0439\u0442\u0430\u043d \u043e\u0432\u043b\u0430\u0434\u0435\u043b \u0438\u043c\u0438 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b \u0438\u0445 \u0437\u0430\u0431\u044b\u0442\u044c \u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u0410\u043b\u043b\u0430\u0445\u0430. \u041e\u043d\u0438 \u2014 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u0438 \u0448\u0430\u0439\u0442\u0430\u043d\u0430. \u0417\u043d\u0430\u0439\u0442\u0435 \u0436\u0435: \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u0438 \u0448\u0430\u0439\u0442\u0430\u043d\u0430 \u2014 \u043e\u043d\u0438 \u0438 \u0435\u0441\u0442\u044c \u043f\u043e\u0442\u0435\u0440\u043f\u0435\u0432\u0448\u0438\u0435 \u0443\u0431\u044b\u0442\u043e\u043a.","footnotes":""},{"id":"5124","sura":"58","aya":"20","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u062d\u064e\u0627\u0653\u062f\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f\u06e5\u0653 \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0630\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0440\u0430\u0436\u0434\u0443\u044e\u0442 \u0441 \u0410\u043b\u043b\u0430\u0445\u043e\u043c \u0438 \u0415\u0433\u043e \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u043e\u043c, \u0442\u0430\u043a\u0438\u0435 \u2014 \u0441\u0440\u0435\u0434\u0438 \u0441\u0430\u043c\u044b\u0445 \u0443\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u0445.","footnotes":""},{"id":"5125","sura":"58","aya":"21","arabic_text":"\u0643\u064e\u062a\u064e\u0628\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0623\u064e\u063a\u06e1\u0644\u0650\u0628\u064e\u0646\u0651\u064e \u0623\u064e\u0646\u064e\u0627\u06e0 \u0648\u064e\u0631\u064f\u0633\u064f\u0644\u0650\u064a\u0653\u06da \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0642\u064e\u0648\u0650\u064a\u0651\u064c \u0639\u064e\u0632\u0650\u064a\u0632\u065e","translation":"\u0410\u043b\u043b\u0430\u0445 \u043f\u0440\u0435\u0434\u043d\u0430\u0447\u0435\u0440\u0442\u0430\u043b: \u00ab\u042f \u043d\u0435\u043f\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043e\u0434\u0435\u0440\u0436\u0443 \u0432\u0435\u0440\u0445 \u2014 \u042f \u0438 \u041c\u043e\u0438 \u043f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u0438!\u00bb \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0410\u043b\u043b\u0430\u0445 \u2014 \u0441\u0438\u043b\u044c\u043d\u044b\u0439, \u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439.","footnotes":""},{"id":"5126","sura":"58","aya":"22","arabic_text":"\u0644\u0651\u064e\u0627 \u062a\u064e\u062c\u0650\u062f\u064f \u0642\u064e\u0648\u06e1\u0645\u0657\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650 \u064a\u064f\u0648\u064e\u0627\u0653\u062f\u0651\u064f\u0648\u0646\u064e \u0645\u064e\u0646\u06e1 \u062d\u064e\u0627\u0653\u062f\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f\u06e5 \u0648\u064e\u0644\u064e\u0648\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0653\u0627\u0652 \u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u0648\u06e1 \u0623\u064e\u0628\u06e1\u0646\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u0648\u06e1 \u0625\u0650\u062e\u06e1\u0648\u064e\u0670\u0646\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u0648\u06e1 \u0639\u064e\u0634\u0650\u064a\u0631\u064e\u062a\u064e\u0647\u064f\u0645\u06e1\u06da \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0643\u064e\u062a\u064e\u0628\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0625\u0650\u064a\u0645\u064e\u0670\u0646\u064e \u0648\u064e\u0623\u064e\u064a\u0651\u064e\u062f\u064e\u0647\u064f\u0645 \u0628\u0650\u0631\u064f\u0648\u062d\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u06d6 \u0648\u064e\u064a\u064f\u062f\u06e1\u062e\u0650\u0644\u064f\u0647\u064f\u0645\u06e1 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u062a\u064e\u062c\u06e1\u0631\u0650\u064a \u0645\u0650\u0646 \u062a\u064e\u062d\u06e1\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0646\u06e1\u0647\u064e\u0670\u0631\u064f \u062e\u064e\u0670\u0644\u0650\u062f\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627\u06da \u0631\u064e\u0636\u0650\u064a\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0631\u064e\u0636\u064f\u0648\u0627\u0652 \u0639\u064e\u0646\u06e1\u0647\u064f\u06da \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u062d\u0650\u0632\u06e1\u0628\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06da \u0623\u064e\u0644\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e \u062d\u0650\u0632\u06e1\u0628\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064f\u0641\u06e1\u0644\u0650\u062d\u064f\u0648\u0646\u064e","translation":"\u0422\u044b \u043d\u0435 \u043d\u0430\u0439\u0434\u0451\u0448\u044c \u043b\u044e\u0434\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0435\u0440\u0443\u044e\u0442 \u0432 \u0410\u043b\u043b\u0430\u0445\u0430 \u0438 \u0432 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0434\u0435\u043d\u044c, \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0449\u0438\u043c\u0438 \u0434\u0440\u0443\u0436\u0431\u0443 \u043a \u0442\u0435\u043c, \u043a\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u0438\u0442\u0441\u044f \u0410\u043b\u043b\u0430\u0445\u0443 \u0438 \u0415\u0433\u043e \u041f\u043e\u0441\u043b\u0430\u043d\u043d\u0438\u043a\u0443, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u0431\u0443\u0434\u0443\u0442 \u0438\u0445 \u043e\u0442\u0446\u044b, \u0438\u043b\u0438 \u0438\u0445 \u0441\u044b\u043d\u043e\u0432\u044c\u044f, \u0438\u043b\u0438 \u0438\u0445 \u0431\u0440\u0430\u0442\u044c\u044f, \u0438\u043b\u0438 \u0438\u0445 \u0440\u043e\u0434\u043d\u044f. \u042d\u0442\u043e \u0442\u0435, \u0432 \u0447\u044c\u0438\u0445 \u0441\u0435\u0440\u0434\u0446\u0430\u0445 \u041e\u043d \u043d\u0430\u0447\u0435\u0440\u0442\u0430\u043b \u0432\u0435\u0440\u0443 \u0438 \u0443\u043a\u0440\u0435\u043f\u0438\u043b \u0438\u0445 \u0434\u0443\u0445\u043e\u043c \u043e\u0442 \u041d\u0435\u0433\u043e. \u041e\u043d \u0432\u0432\u0435\u0434\u0451\u0442 \u0438\u0445 \u0432 \u0441\u0430\u0434\u044b, \u043f\u043e\u0434 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u0442\u0435\u043a\u0443\u0442 \u0440\u0435\u043a\u0438; \u043e\u043d\u0438 \u043f\u0440\u0435\u0431\u0443\u0434\u0443\u0442 \u0442\u0430\u043c \u0432\u0435\u0447\u043d\u043e. \u0410\u043b\u043b\u0430\u0445 \u0434\u043e\u0432\u043e\u043b\u0435\u043d \u0438\u043c\u0438, \u0438 \u043e\u043d\u0438 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u044b \u0418\u043c. \u041e\u043d\u0438 \u2014 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u0438 \u0410\u043b\u043b\u0430\u0445\u0430. \u0417\u043d\u0430\u0439\u0442\u0435 \u0436\u0435: \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435, \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u043a\u0438 \u0410\u043b\u043b\u0430\u0445\u0430 \u2014 \u043e\u043d\u0438 \u0438 \u0435\u0441\u0442\u044c \u043f\u0440\u0435\u0443\u0441\u043f\u0435\u0432\u0448\u0438\u0435.","footnotes":""}]}