6e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u044d\u0442\u043e \u2014 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0431\u043e\u0433\u043e\u0431\u043e\u044f\u0437\u043d\u0435\u043d\u043d\u044b\u0445.","footnotes":""},{"id":"5372","sura":"69","aya":"49","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0646\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0623\u064e\u0646\u0651\u064e \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"\u0418, \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041c\u044b \u0437\u043d\u0430\u0435\u043c, \u0447\u0442\u043e \u0441\u0440\u0435\u0434\u0438 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0441\u0447\u0438\u0442\u0430\u044e\u0449\u0438\u0435 \u044d\u0442\u043e \u043b\u043e\u0436\u044c\u044e.","footnotes":""},{"id":"5373","sura":"69","aya":"50","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0633\u06e1\u0631\u064e\u0629\u064c \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e","translation":"\u0418 \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u044d\u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0442 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0445 \u0432\u0435\u0440\u0443.","footnotes":""},{"id":"5374","sura":"69","aya":"51","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"\u0418 \u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u044d\u0442\u043e \u2014 \u043d\u0435\u0441\u043e\u043c\u043d\u0435\u043d\u043d\u0430\u0