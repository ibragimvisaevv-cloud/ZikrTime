"arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u0627\u0639\u0650\u0631\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"\u0418 \u044d\u0442\u043e \u2014 \u0432\u043e\u0432\u0441\u0435 \u043d\u0435 \u0440\u0435\u0447\u044c \u043f\u043e\u044d\u0442\u0430. \u041a\u0430\u043a \u0436\u0435 \u043c\u0430\u043b\u043e \u0432\u044b \u0432\u0435\u0440\u0443\u0435\u0442\u0435.","footnotes":""},{"id":"5365","sura":"69","aya":"42","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0643\u064e\u0627\u0647\u0650\u0646\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"\u0418 \u044d\u0442\u043e \u0432\u043e\u0432\u0441\u0435 \u043d\u0435 \u0441\u043b\u043e\u0432\u043e \u043f\u0440\u043e\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044f. \u041a\u0430\u043a \u0436\u0435 \u043c\u0430\u043b\u043e \u0432\u044b \u0432\u043d\u0435\u043c\u043b\u0435\u0442\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044e.","footnotes":""},{"id":"5366","sura":"69","aya":"43","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"[\u042d\u0442\u043e \u2014] \u043d\u0438\u0441\u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0435 \u043e\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043c\u0438\u0440\u043e\u0432.","footnotes":""},{"id":"5367","sura":"69","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u062a\u064e\u0642\u064e\u0648\u0651\u064e\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u0639\u06e1\u0636\u064e \