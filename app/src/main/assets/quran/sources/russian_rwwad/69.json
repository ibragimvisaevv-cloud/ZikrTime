430\u0441\u0447\u0451\u0442!\u00bb","footnotes":""},{"id":"5344","sura":"69","aya":"21","arabic_text":"\u0641\u064e\u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0639\u0650\u064a\u0634\u064e\u0629\u0656 \u0631\u0651\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u0656","translation":"\u0418 \u043e\u043d \u043e\u043a\u0430\u0436\u0435\u0442\u0441\u044f \u0432 \u0436\u0438\u0437\u043d\u0438 \u0431\u043b\u0430\u0436\u0435\u043d\u043d\u043e\u0439,","footnotes":""},{"id":"5345","sura":"69","aya":"22","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0629\u064d \u0639\u064e\u0627\u0644\u0650\u064a\u064e\u0629\u0656","translation":"\u0432 \u0432\u043e\u0437\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u043c \u0420\u0430\u044e,","footnotes":""},{"id":"5346","sura":"69","aya":"23","arabic_text":"\u0642\u064f\u0637\u064f\u0648\u0641\u064f\u0647\u064e\u0627 \u062f\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u065e","translation":"\u043f\u043b\u043e\u0434\u044b \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u0443\u0434\u0443\u0442 \u0431\u043b\u0438\u0437\u043a\u0438.","footnotes":""},{"id":"5347","sura":"69","aya":"24","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0644\u064e\u0641\u06e1\u062a\u064f\u0645\u06e1 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u064a\u0651\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u062e\u064e\u0627\u0644\u0650\u064a\u064e\u0629\u0650","translation":"\u00ab\u0415\u0448\u044c\u0442\u0435 \u0438 \u043f\u0435\u0439\u0442\u0435 \u0432\u043e \u0437\u0434\u0440\u0430\u0432\u0438\u0435 \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0432\u044b \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u043b\u0438 \u0432 \u043c\u0438\u043d\u0443\u0432\u0448\u0438\u0435 \u0434\u043d\u0438!\u00bb","footnotes":""},{"id":"5348","sura":"69","ay