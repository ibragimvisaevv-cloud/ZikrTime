40","sura":"71","aya":"21","arabic_text":"\u0642\u064e\u0627\u0644\u064e \u0646\u064f\u0648\u062d\u065e \u0631\u0651\u064e\u0628\u0651\u0650 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0635\u064e\u0648\u06e1\u0646\u0650\u064a \u0648\u064e\u0671\u062a\u0651\u064e\u0628\u064e\u0639\u064f\u0648\u0627\u0652 \u0645\u064e\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u0632\u0650\u062f\u06e1\u0647\u064f \u0645\u064e\u0627\u0644\u064f\u0647\u064f\u06e5 \u0648\u064e\u0648\u064e\u0644\u064e\u062f\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u062e\u064e\u0633\u064e\u0627\u0631\u0657\u0627","translation":"\u041d\u0443\u0445 \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043c\u043e\u0439! \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u043e\u043d\u0438 \u043e\u0441\u043b\u0443\u0448\u0430\u043b\u0438\u0441\u044c \u043c\u0435\u043d\u044f \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0438 \u0437\u0430 \u0442\u0435\u043c, \u043a\u043e\u043c\u0443 \u0431\u043e\u0433\u0430\u0442\u0441\u0442\u0432\u043e \u0438 \u0434\u0435\u0442\u0438 \u043d\u0435 \u043f\u0440\u0438\u0443\u043c\u043d\u043e\u0436\u0438\u043b\u0438 \u043d\u0438\u0447\u0435\u0433\u043e, \u043a\u0440\u043e\u043c\u0435 \u0443\u0431\u044b\u0442\u043a\u0430.","footnotes":""},{"id":"5441","sura":"71","aya":"22","arabic_text":"\u0648\u064e\u0645\u064e\u0643\u064e\u0631\u064f\u0648\u0627\u0652 \u0645\u064e\u0643\u06e1\u0631\u0657\u0627 \u0643\u064f\u0628\u0651\u064e\u0627\u0631\u0657\u0627","translation":"\u0418 \u043e\u043d\u0438 \u0437\u0430\u043c\u044b\u0441\u043b\u0438\u043b\u0438 \u0432\u0435\u043b\u0438\u043a\u043e\u0435 \u043a\u043e\u0432\u0430\u0440\u0441\u0442\u0432\u043e,","footnotes":""},{"id":"5442","sura":"71","aya":"23","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f\u0646\u0651\u064e \u0621\u064e\u0627\u0644\u0650\u0647\u064e\u062a\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f\u0646\u0651\u064e \u0648\u064e\u062f\u0651\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0633\u064f\u0648\u064e\u0627\u0639\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u063a\u064f\u0648\u062b\u064e \u0648\u064e\u064a\u064e\u0639\u064f\u0648\u0642\u064e \u0648\u064e\u0646\u064e\u0633\u06e1\u0631\u0657\u0627","translation":"\u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0438: \u201c\u041d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u043d\u0438 \u0432 \u043a\u043e\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u0432\u0430\u0448\u0438 \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0430: \u043d\u0438 \u0412\u0430\u0434\u0434\u0430, \u043d\u0438 \u0421\u0443\u0432\u0430\u2018\u0430, \u043d\u0438 \u042f\u0433\u0443\u0441\u0430, \u043d\u0438 \u042f\u2018\u0443\u043a\u0430, \u043d\u0438 \u041d\u0430\u0441\u0440\u0430!\u201d","footnotes":""},{"id":"5443","sura":"71","aya":"24","arabic_text":"\u0648\u064e\u0642\u064e\u062f\u06e1 \u0623\u064e\u0636\u064e\u0644\u0651\u064f\u0648\u0627\u0652 \u0643\u064e\u062b\u0650\u064a\u0631\u0657\u0627\u06d6 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0632\u0650\u062f\u0650 \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0636\u064e\u0644\u064e\u0670\u0644\u0657\u0627","translation":"\u041e\u043d\u0438 \u0443\u0436\u0435 \u0432\u0432\u0435\u043b\u0438 \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u043c\u043d\u043e\u0433\u0438\u0445. \u0418 \u043d\u0435 \u043f\u0440\u0438\u0443\u043c\u043d\u043e\u0436\u0430\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u044b\u043c \u043d\u0438\u0447\u0435\u0433\u043e, \u043a\u0440\u043e\u043c\u0435 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u044f!\u00bb","footnotes":""},{"id":"5444","sura":"71","aya":"25","arabic_text":"\u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u062e\u064e\u0637\u0650\u064a\u0653\u0640\u0654\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0623\u064f\u063a\u06e1\u0631\u0650\u0642\u064f\u0648\u0627\u0652 \u0641\u064e\u0623\u064f\u062f\u06e1\u062e\u0650\u0644\u064f\u0648\u0627\u0652 \u0646\u064e\u0627\u0631\u0657\u0627 \u0641\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u062c\u0650\u062f\u064f\u0648\u0627\u0652 \u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u0657\u0627","translation":"\u0417\u0430 \u0441\u0432\u043e\u0438 \u0433\u0440\u0435\u0445\u0438 \u043e\u043d\u0438 \u0431\u044b\u043b\u0438 \u043f\u043e\u0442\u043e\u043f\u043b\u0435\u043d\u044b, \u0430 \u0437\u0430\u0442\u0435\u043c \u0432\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b \u0432 \u0430\u0434\u0441\u043a\u0438\u0439 \u043e\u0433\u043e\u043d\u044c. \u0418 \u043e\u043d\u0438 \u043d\u0435 \u043d\u0430\u0448\u043b\u0438 \u0434\u043b\u044f \u0441\u0435\u0431\u044f, \u043f\u043e\u043c\u0438\u043c\u043e \u0410\u043b\u043b\u0430\u0445\u0430, \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u0432.","footnotes":""},{"id":"5445","sura":"71","aya":"26","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0646\u064f\u0648\u062d\u065e \u0631\u0651\u064e\u0628\u0651\u0650 \u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u06e1 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u062f\u064e\u064a\u0651\u064e\u0627\u0631\u064b\u0627","translation":"\u0418 \u041d\u0443\u0445 \u0441\u043a\u0430\u0437\u0430\u043b: \u00ab\u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043c\u043e\u0439! \u041d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0439 \u043d\u0430 \u0437\u0435\u043c\u043b\u0435 \u0438\u0437 \u0447\u0438\u0441\u043b\u0430 \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0445 \u0432\u0435\u0440\u0443 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u044f.","footnotes":""},{"id":"5446","sura":"71","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0625\u0650\u0646 \u062a\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064f\u0636\u0650\u0644\u0651\u064f\u0648\u0627\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u064e\u0643\u064e \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0644\u0650\u062f\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u064e\u0627\u062c\u0650\u0631\u0657\u0627 \u0643\u064e\u0641\u0651\u064e\u0627\u0631\u0657\u0627","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0435\u0441\u043b\u0438 \u0422\u044b \u043e\u0441\u0442\u0430\u0432\u0438\u0448\u044c \u0438\u0445, \u043e\u043d\u0438 \u0441\u043e\u0431\u044c\u044e\u0442 \u0441 \u043f\u0443\u0442\u0438 \u0422\u0432\u043e\u0438\u0445 \u0440\u0430\u0431\u043e\u0432 \u0438 \u043d\u0435 \u043f\u043e\u0440\u043e\u0434\u044f\u0442 \u043d\u0438\u043a\u043e\u0433\u043e, \u043a\u0440\u043e\u043c\u0435 \u0440\u0430\u0441\u043f\u0443\u0442\u043d\u043e\u0433\u043e, \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0435\u0433\u043e \u0432\u0435\u0440\u0443.","footnotes":""},{"id":"5447","sura":"71","aya":"28","arabic_text":"\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u063a\u06e1\u0641\u0650\u0631\u06e1 \u0644\u0650\u064a \u0648\u064e\u0644\u0650\u0648\u064e\u0670\u0644\u0650\u062f\u064e\u064a\u0651\u064e \u0648\u064e\u0644\u0650\u0645\u064e\u0646 \u062f\u064e\u062e\u064e\u0644\u064e \u0628\u064e\u064a\u06e1\u062a\u0650\u064a\u064e \u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0657\u0627 \u0648\u064e\u0644\u0650\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064e\u0670\u062a\u0650\u06d6 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0632\u0650\u062f\u0650 \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u062a\u064e\u0628\u064e\u0627\u0631\u064e\u06e2\u0627","translation":"\u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043c\u043e\u0439! \u041f\u0440\u043e\u0441\u0442\u0438 \u043c\u0435\u043d\u044f, \u043c\u043e\u0438\u0445 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439, \u0438 \u0442\u043e\u0433\u043e, \u043a\u0442\u043e \u0432\u043e\u0448\u0451\u043b \u0432 \u043c\u043e\u0439 \u0434\u043e\u043c \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0445 \u043c\u0443\u0436\u0447\u0438\u043d \u0438 \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0445 \u0436\u0435\u043d\u0449\u0438\u043d. \u0418 \u043d\u0435 \u043f\u0440\u0438\u0443\u043c\u043d\u043e\u0436\u0430\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u044b\u043c \u043d\u0438\u0447\u0435\u0433\u043e, \u043a\u0440\u043e\u043c\u0435 \u043f\u043e\u0433\u0438\u0431\u0435\u043b\u0438\u00bb.","footnotes":""}]}