tes":""},{"id":"5611","sura":"76","aya":"20","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u064a\u06e1\u062a\u064e \u062b\u064e\u0645\u0651\u064e \u0631\u064e\u0623\u064e\u064a\u06e1\u062a\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0657\u0627 \u0648\u064e\u0645\u064f\u0644\u06e1\u0643\u0657\u0627 \u0643\u064e\u0628\u0650\u064a\u0631\u064b\u0627","translation":"\u0410 \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u0432\u0437\u0433\u043b\u044f\u043d\u0435\u0448\u044c, \u0442\u043e \u0443\u0432\u0438\u0434\u0438\u0448\u044c \u0442\u0430\u043c \u0431\u043b\u0430\u0436\u0435\u043d\u0441\u0442\u0432\u043e \u0438 \u0432\u0435\u043b\u0438\u043a\u043e\u0435 \u0432\u043b\u0430\u0434\u044b\u0447\u0435\u0441\u0442\u0432\u043e.","footnotes":""},{"id":"5612","sura":"76","aya":"21","arabic_text":"\u0639\u064e\u0670\u0644\u0650\u064a\u064e\u0647\u064f\u0645\u06e1 \u062b\u0650\u064a\u064e\u0627\u0628\u064f \u0633\u064f\u0646\u062f\u064f\u0633\u064d \u062e\u064f\u0636\u06e1\u0631\u065e \u0648\u064e\u0625\u0650\u0633\u06e1\u062a\u064e\u0628\u06e1\u0631\u064e\u0642\u065e\u06d6 \u0648\u064e\u062d\u064f\u0644\u0651\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0633\u064e\u0627\u0648\u0650\u0631\u064e \u0645\u0650\u0646 \u0641\u0650\u0636\u0651\u064e\u0629\u0656 \u0648\u064e\u0633\u064e\u0642\u064e\u0649\u0670\u0647\u064f\u0645\u06e1 \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0631\u064e\u0627\u0628\u0657\u0627 \u0637\u064e\u0647\u064f\u0648\u0631\u064b\u0627","translation":"\u041d\u0430 \u043d\u0438\u0445 \u0431\u0443\u0434\u0443\u0442 \u0437\u0435\u043b\u0451\u043d\u044b\u0435 \u043e\u0434\u0435\u044f\u043d\u0438\u044f \u0438\u0437 \u0442\u043e\u043d\u043a\u043e\u0433\u043e \u0448\u0451\u043b\u043a\u0430 \u0438 \u043f\u0430\u0440\u0447\u0438, \u0438 \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0443\u043a\u0440\u0430\u0448\u0435\u043d\u044b \u0431\u0440\u0430\u0441\u043b\u0435\u0442\u0430\u043c\u0438 \u0438\u0437 \u0441\u0435\u0440\u0435\u0431\u0440\u0430, \u0438 \u0438\u0445 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043d\u0430\u043f\u043e\u0438\u0442 \u0438\u0445 \u043d\u0430\u043f\u0438\u0442\u043a\u043e\u043c \u0447\u0438\u0441\u0442\u0435\u0439\u0448\u0438\u043c.","footnotes":""},{"id":"5613","sura":"76","aya":"22","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u062c\u064e\u0632\u064e\u0627\u0653\u0621\u0657 \u0648\u064e\u0643\u064e\u0627\u0646\u064e \u0633\u064e\u0639\u06e1\u064a\u064f\u0643\u064f\u0645 \u0645\u0651\u064e\u0634\u06e1\u0643\u064f\u0648\u0631\u064b\u0627","translation":"[\u0418\u043c \u0431\u0443\u0434\u0435\u0442 \u0441\u043a\u0430\u0437\u0430\u043d\u043e:] \u00ab\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u0432\u0430\u0448\u0435 \u0432\u043e\u0437\u0434\u0430\u044f\u043d\u0438\u0435, \u0438 \u0432\u0430\u0448\u0435 \u0443\u0441\u0435\u0440\u0434\u0438\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u043e \u0441 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c\u044e\u00bb.","footnotes":""},{"id":"5614","sura":"76","aya":"23","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0646\u064e\u0632\u0651\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064e \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e \u062a\u064e\u0646\u0632\u0650\u064a\u0644\u0657\u0627","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041c\u044b \u043d\u0438\u0437\u0432\u0435\u043b\u0438 \u0442\u0435\u0431\u0435 \u041a\u043e\u0440\u0430\u043d \u043d\u0438\u0441\u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0435\u043c.","footnotes":""},{"id":"5615","sura":"76","aya":"24","arabic_text":"\u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1 \u0644\u0650\u062d\u064f\u0643\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064f\u0637\u0650\u0639\u06e1 \u0645\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0621\u064e\u0627\u062b\u0650\u0645\u064b\u0627 \u0623\u064e\u0648\u06e1 \u0643\u064e\u0641\u064f\u0648\u0631\u0657\u0627","translation":"\u0422\u0430\u043a \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0439 \u0436\u0435 \u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435 \u043a \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0442\u0432\u043e\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0438 \u043d\u0435 \u043f\u043e\u0432\u0438\u043d\u0443\u0439\u0441\u044f \u043d\u0438\u043a\u043e\u043c\u0443 \u0438\u0437 \u043d\u0438\u0445 \u2014 \u043d\u0438 \u0433\u0440\u0435\u0448\u043d\u0438\u043a\u0443, \u043d\u0438 \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0435\u043c\u0443 \u0432\u0435\u0440\u0443.","footnotes":""},{"id":"5616","sura":"76","aya":"25","arabic_text":"\u0648\u064e\u0671\u0630\u06e1\u0643\u064f\u0631\u0650 \u0671\u0633\u06e1\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0628\u064f\u0643\u06e1\u0631\u064e\u0629\u0657 \u0648\u064e\u0623\u064e\u0635\u0650\u064a\u0644\u0657\u0627","translation":"\u0418 \u043f\u043e\u043c\u0438\u043d\u0430\u0439 \u0438\u043c\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0443\u0442\u0440\u043e\u043c \u0438 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043a\u0430\u0442\u043e\u043c,","footnotes":""},{"id":"5617","sura":"76","aya":"26","arabic_text":"\u0648\u064e\u0645\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0641\u064e\u0671\u0633\u06e1\u062c\u064f\u062f\u06e1 \u0644\u064e\u0647\u064f\u06e5 \u0648\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1\u0647\u064f \u0644\u064e\u064a\u06e1\u0644\u0657\u0627 \u0637\u064e\u0648\u0650\u064a\u0644\u064b\u0627","translation":"\u0438 \u043d\u043e\u0447\u044c\u044e \u2014 \u043f\u0430\u0434\u0438 \u043d\u0438\u0446 \u043f\u0440\u0435\u0434 \u041d\u0438\u043c \u0438 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u044f\u0439 \u0415\u0433\u043e \u0434\u043e\u043b\u0433\u043e\u0439 \u043d\u043e\u0447\u044c\u044e.","footnotes":""},{"id":"5618","sura":"76","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0653\u0624\u064f\u0644\u064e\u0627\u0653\u0621\u0650 \u064a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0639\u064e\u0627\u062c\u0650\u0644\u064e\u0629\u064e \u0648\u064e\u064a\u064e\u0630\u064e\u0631\u064f\u0648\u0646\u064e \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u0657\u0627 \u062b\u064e\u0642\u0650\u064a\u0644\u0657\u0627","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u043e\u043d\u0438 \u043b\u044e\u0431\u044f\u0442 \u0441\u043a\u043e\u0440\u043e\u0442\u0435\u0447\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c, \u0430 \u043f\u043e\u0437\u0430\u0434\u0438 \u0441\u0435\u0431\u044f \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0442\u044f\u0433\u043e\u0441\u0442\u043d\u044b\u0439 \u0434\u0435\u043d\u044c.","footnotes":""},{"id":"5619","sura":"76","aya":"28","arabic_text":"\u0646\u0651\u064e\u062d\u06e1\u0646\u064f \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645\u06e1 \u0648\u064e\u0634\u064e\u062f\u064e\u062f\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0631\u064e\u0647\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0634\u0650\u0626\u06e1\u0646\u064e\u0627 \u0628\u064e\u062f\u0651\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1\u062b\u064e\u0670\u0644\u064e\u0647\u064f\u0645\u06e1 \u062a\u064e\u0628\u06e1\u062f\u0650\u064a\u0644\u064b\u0627","translation":"\u041c\u044b \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u043b\u0438 \u0438\u0445 \u0438 \u0443\u043a\u0440\u0435\u043f\u0438\u043b\u0438 \u0438\u0445 \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0430 \u0435\u0441\u043b\u0438 \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u043c \u2014 \u0437\u0430\u043c\u0435\u043d\u0438\u043c \u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u043c\u0438, \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u043c\u0438 \u0438\u043c.","footnotes":""},{"id":"5620","sura":"76","aya":"29","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0630\u0650\u0647\u0650\u06e6 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e\u06d6 \u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0633\u064e\u0628\u0650\u064a\u0644\u0657\u0627","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u044d\u0442\u043e \u2014 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435. \u0418 \u043a\u0442\u043e \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442 \u2014 \u0438\u0437\u0431\u0435\u0440\u0451\u0442 \u043f\u0443\u0442\u044c \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u0413\u043e\u0441\u043f\u043e\u0434\u0443.","footnotes":""},{"id":"5621","sura":"76","aya":"30","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u0650\u064a\u0645\u064b\u0627 \u062d\u064e\u0643\u0650\u064a\u0645\u0657\u0627","translation":"\u041d\u043e \u0432\u044b \u043d\u0435 \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442\u0435 \u0438\u043d\u0430\u0447\u0435 \u043a\u0430\u043a \u043f\u043e \u0432\u043e\u043b\u0435 \u0410\u043b\u043b\u0430\u0445\u0430. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0410\u043b\u043b\u0430\u0445 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b [\u0438 \u043f\u0440\u0435\u0431\u0443\u0434\u0435\u0442] \u0437\u043d\u0430\u044e\u0449\u0438\u043c, \u043c\u0443\u0434\u0440\u044b\u043c.","footnotes":""},{"id":"5622","sura":"76","aya":"31","arabic_text":"\u064a\u064f\u062f\u06e1\u062e\u0650\u0644\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0641\u0650\u064a \u0631\u064e\u062d\u06e1\u0645\u064e\u062a\u0650\u0647\u0650\u06e6\u06da \u0648\u064e\u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0623\u064e\u0639\u064e\u062f\u0651\u064e \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064b\u0627 \u0623\u064e\u0644\u0650\u064a\u0645\u064e\u06e2\u0627","translation":"\u041e\u043d \u0432\u0432\u043e\u0434\u0438\u0442, \u043a\u043e\u0433\u043e \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442, \u0432 \u0421\u0432\u043e\u044e \u043c\u0438\u043b\u043e\u0441\u0442\u044c. \u0410 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u044b\u0435 \u2014 \u041e\u043d \u0443\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0438\u043c \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435.","footnotes":""}]}