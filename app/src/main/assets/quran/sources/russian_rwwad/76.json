43\u043f\u043d\u044b \u0434\u043b\u044f \u0441\u0431\u043e\u0440\u0430.","footnotes":""},{"id":"5606","sura":"76","aya":"15","arabic_text":"\u0648\u064e\u064a\u064f\u0637\u064e\u0627\u0641\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645 \u0628\u0650\u0640\u0654\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u0656 \u0645\u0651\u0650\u0646 \u0641\u0650\u0636\u0651\u064e\u0629\u0656 \u0648\u064e\u0623\u064e\u0643\u06e1\u0648\u064e\u0627\u0628\u0656 \u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0642\u064e\u0648\u064e\u0627\u0631\u0650\u064a\u0631\u064e\u0627\u06e0","translation":"\u0418\u0445 \u0431\u0443\u0434\u0443\u0442 \u043e\u0431\u043d\u043e\u0441\u0438\u0442\u044c \u0441\u043e\u0441\u0443\u0434\u0430\u043c\u0438 \u0438\u0437 \u0441\u0435\u0440\u0435\u0431\u0440\u0430 \u0438 \u043a\u0443\u0431\u043a\u0430\u043c\u0438 \u0438\u0437 \u0445\u0440\u0443\u0441\u0442\u0430\u043b\u044f \u2014","footnotes":""},{"id":"5607","sura":"76","aya":"16","arabic_text":"\u0642\u064e\u0648\u064e\u0627\u0631\u0650\u064a\u0631\u064e\u0627\u0652 \u0645\u0650\u0646 \u0641\u0650\u0636\u0651\u064e\u0629\u0656 \u0642\u064e\u062f\u0651\u064e\u0631\u064f\u0648\u0647\u064e\u0627 \u062a\u064e\u0642\u06e1\u062f\u0650\u064a\u0631\u0657\u0627","translation":"\u0445\u0440\u0443\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438 [\u043a\u0443\u0431\u043a\u0430\u043c\u0438] \u0438\u0437 \u0441\u0435\u0440\u0435\u0431\u0440\u0430, \u043c\u0435\u0440\u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d\u0438 \u043e\u0442\u043c\u0435\u0440\u0438\u043b\u0438 \u0442\u043e\u0447\u043d\u0435\u0439\u0448\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c.","footnotes":""},{"id":"5608","sura":"76","aya":"17","arabic_text":"\u0648\u064e\u064a\u064f\u0633\u06e1\u0642\u064e\u0648\u06e1\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0643\u064e\u0623\u06e1\u0633\u0657\u0627 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0632\u064e\u0627\u062c\u064f\u0647\u064e\u0627 \u0632\u064e\u0646\u062