,"sura":"67","aya":"9","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0628\u064e\u0644\u064e\u0649\u0670 \u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e\u0646\u064e\u0627 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0641\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u06e1\u0646\u064e\u0627 \u0648\u064e\u0642\u064f\u0644\u06e1\u0646\u064e\u0627 \u0645\u064e\u0627 \u0646\u064e\u0632\u0651\u064e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u0650\u0646 \u0634\u064e\u064a\u06e1\u0621\u064d \u0625\u0650\u0646\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u064a \u0636\u064e\u0644\u064e\u0670\u0644\u0656 \u0643\u064e\u0628\u0650\u064a\u0631\u0656","translation":"\u041e\u043d\u0438 \u0441\u043a\u0430\u0436\u0443\u0442: \u00ab\u0414\u0430, \u043a \u043d\u0430\u043c \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u044e\u0449\u0438\u0439, \u043d\u043e \u043c\u044b \u0441\u043e\u0447\u043b\u0438 \u0435\u0433\u043e \u043b\u0436\u0435\u0446\u043e\u043c \u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0438: \u201c\u0410\u043b\u043b\u0430\u0445 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043d\u0438\u0441\u043f\u043e\u0441\u044b\u043b\u0430\u043b, \u0430 \u0432\u044b \u2014 \u043d\u0435 \u0438\u043d\u0430\u0447\u0435 \u043a\u0430\u043a \u0432 \u0431\u043e\u043b\u044c\u0448\u043e\u043c \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0438\u201d\u00bb.","footnotes":""},{"id":"5251","sura":"67","aya":"10","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0648\u06e1 \u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u0633\u06e1\u0645\u064e\u0639\u064f \u0623\u064e\u0648\u06e1 \u0646\u064e\u0639\u06e1\u0642\u0650\u0644\u064f \u0645\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0641\u0650\u064a\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u0633\u0651\u064e\u0639\u0650\u064a\u0631\u0650","translation":"\u0418 \u043e\u043d\u0438 \u0441\u043a\u0430\u0436\u0443\u0442: \u00ab\u0415\u0441\u043b\u0438 \u0431\u044b \u043c\u044b \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u043b\u0438 \u0438\u043b\u0438 \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0438, \u043c\u044b \u043d\u0435 \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u0431\u044b \u0441\u0440\u0435\u0434\u0438 \u043e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u0439 \u043f\u044b\u043b\u0430\u044e\u0449\u0435\u0433\u043e \u043e\u0433\u043d\u044f\u00bb.","footnotes":""},{"id":"5252","sura":"67","aya":"11","arabic_text":"\u0641\u064e\u0671\u0639\u06e1\u062a\u064e\u0631\u064e\u0641\u064f\u0648\u0627\u0652 \u0628\u0650\u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0633\u064f\u062d\u06e1\u0642\u0657\u0627 \u0644\u0651\u0650\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u0633\u0651\u064e\u0639\u0650\u064a\u0631\u0650","translation":"\u041e\u043d\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0438\u0441\u044c \u0432 \u0441\u0432\u043e\u0451\u043c \u0433\u0440\u0435\u0445\u0435. \u041f\u043e\u0433\u0438\u0431\u0435\u043b\u044c \u043e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u044f\u043c \u043f\u044b\u043b\u0430\u044e\u0449\u0435\u0433\u043e \u043e\u0433\u043d\u044f!","footnotes":""},{"id":"5253","sura":"67","aya":"12","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062e\u06e1\u0634\u064e\u0648\u06e1\u0646\u064e \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u065e \u0648\u064e\u0623\u064e\u062c\u06e1\u0631\u065e \u0643\u064e\u0628\u0650\u064a\u0631\u065e","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0442\u0440\u0430\u0448\u0430\u0442\u0441\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0432\u0442\u0430\u0439\u043d\u0435, \u2014 \u0434\u043b\u044f \u043d\u0438\u0445 \u043f\u0440\u043e\u0449\u0435\u043d\u0438\u0435 \u0438 \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u0430.","footnotes":""},{"id":"5254","sura":"67","aya":"13","arabic_text":"\u0648\u064e\u0623\u064e\u0633\u0650\u0631\u0651\u064f\u0648\u0627\u0652 \u0642\u064e\u0648\u06e1\u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u0648\u0650 \u0671\u062c\u06e1\u0647\u064e\u0631\u064f\u0648\u0627\u0652 \u0628\u0650\u0647\u0650\u06e6\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0639\u064e\u0644\u0650\u064a\u0645\u064f\u06e2 \u0628\u0650\u0630\u064e\u0627\u062a\u0650 \u0671\u0644\u0635\u0651\u064f\u062f\u064f\u0648\u0631\u0650","translation":"\u0421\u043a\u0440\u043e\u0435\u0442\u0435 \u043b\u0438 \u0432\u044b \u0441\u0432\u043e\u0451 \u0441\u043b\u043e\u0432\u043e \u0438\u043b\u0438 \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441\u0451\u0442\u0435 \u0435\u0433\u043e \u0432\u0441\u043b\u0443\u0445 \u2014 \u041e\u043d \u0437\u043d\u0430\u0435\u0442 \u0441\u043e\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e\u0435 \u0432 \u0441\u0435\u0440\u0434\u0446\u0430\u0445.","footnotes":""},{"id":"5255","sura":"67","aya":"14","arabic_text":"\u0623\u064e\u0644\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0645\u064e\u0646\u06e1 \u062e\u064e\u0644\u064e\u0642\u064e \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u0644\u0651\u064e\u0637\u0650\u064a\u0641\u064f \u0671\u0644\u06e1\u062e\u064e\u0628\u0650\u064a\u0631\u064f","translation":"\u0420\u0430\u0437\u0432\u0435 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442 \u0422\u043e\u0442, \u041a\u0442\u043e \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u043b, \u0442\u043e\u0433\u0434\u0430 \u043a\u0430\u043a \u041e\u043d \u2014 \u041f\u0440\u043e\u043d\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439, \u0421\u0432\u0435\u0434\u0443\u0449\u0438\u0439?","footnotes":""},{"id":"5256","sura":"67","aya":"15","arabic_text":"\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062c\u064e\u0639\u064e\u0644\u064e \u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0630\u064e\u0644\u064f\u0648\u0644\u0657\u0627 \u0641\u064e\u0671\u0645\u06e1\u0634\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u0645\u064e\u0646\u064e\u0627\u0643\u0650\u0628\u0650\u0647\u064e\u0627 \u0648\u064e\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0645\u0650\u0646 \u0631\u0651\u0650\u0632\u06e1\u0642\u0650\u0647\u0650\u06e6\u06d6 \u0648\u064e\u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0671\u0644\u0646\u0651\u064f\u0634\u064f\u0648\u0631\u064f","translation":"\u041e\u043d \u2014 \u0422\u043e\u0442, \u041a\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b \u0434\u043b\u044f \u0432\u0430\u0441 \u0437\u0435\u043c\u043b\u044e \u043f\u043e\u043a\u043e\u0440\u043d\u043e\u0439; \u0442\u0430\u043a \u0445\u043e\u0434\u0438\u0442\u0435 \u0436\u0435 \u043f\u043e \u0435\u0451 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0430\u043c \u0438 \u0435\u0448\u044c\u0442\u0435 \u0438\u0437 \u0415\u0433\u043e \u0443\u0434\u0435\u043b\u0430. \u0418 \u043a \u041d\u0435\u043c\u0443 \u2014 \u0432\u043e\u0441\u043a\u0440\u0435\u0448\u0435\u043d\u0438\u0435.","footnotes":""},{"id":"5257","sura":"67","aya":"16","arabic_text":"\u0621\u064e\u0623\u064e\u0645\u0650\u0646\u062a\u064f\u0645 \u0645\u0651\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0623\u064e\u0646 \u064a\u064e\u062e\u06e1\u0633\u0650\u0641\u064e \u0628\u0650\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0647\u0650\u064a\u064e \u062a\u064e\u0645\u064f\u0648\u0631\u064f","translation":"\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u0432\u044b \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0441\u0435\u0431\u044f \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043e\u0442 \u0422\u043e\u0433\u043e, \u041a\u0442\u043e \u043d\u0430 \u043d\u0435\u0431\u0435, \u0447\u0442\u043e \u041e\u043d \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442 \u0437\u0435\u043c\u043b\u044e \u043f\u043e\u0433\u043b\u043e\u0442\u0438\u0442\u044c \u0432\u0430\u0441 \u2014 \u0438 \u0432\u043e\u0442 \u043e\u043d\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442 \u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435?","footnotes":""},{"id":"5258","sura":"67","aya":"17","arabic_text":"\u0623\u064e\u0645\u06e1 \u0623\u064e\u0645\u0650\u0646\u062a\u064f\u0645 \u0645\u0651\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0623\u064e\u0646 \u064a\u064f\u0631\u06e1\u0633\u0650\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u06e1 \u062d\u064e\u0627\u0635\u0650\u0628\u0657\u0627\u06d6 \u0641\u064e\u0633\u064e\u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0646\u064e\u0630\u0650\u064a\u0631\u0650","translation":"\u0418\u043b\u0438 \u0436\u0435 \u0432\u044b \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0441\u0435\u0431\u044f \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043e\u0442 \u0422\u043e\u0433\u043e, \u041a\u0442\u043e \u043d\u0430 \u043d\u0435\u0431\u0435, \u0447\u0442\u043e \u041e\u043d \u043f\u043e\u0448\u043b\u0451\u0442 \u043d\u0430 \u0432\u0430\u0441 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0445\u0440\u044c? \u0418 \u0432\u044b \u0443\u0437\u043d\u0430\u0435\u0442\u0435, \u043a\u0430\u043a\u043e\u0432\u043e \u041c\u043e\u0451 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0435!","footnotes":""},{"id":"5259","sura":"67","aya":"18","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0643\u064e\u064a\u06e1\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0646\u064e\u0643\u0650\u064a\u0631\u0650","translation":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u0434\u043e \u043d\u0438\u0445, \u0441\u043e\u0447\u043b\u0438 \u0438\u0441\u0442\u0438\u043d\u0443 \u043b\u043e\u0436\u044c\u044e \u2014 \u0442\u0430\u043a \u043a\u0430\u043a\u043e\u0432\u043e \u0436\u0435 \u0431\u044b\u043b\u043e \u041c\u043e\u0451 \u043d\u0435\u0433\u043e\u0434\u043e\u0432\u0430\u043d\u0438\u0435?","footnotes":""},{"id":"5260","sura":"67","aya":"19","arabic_text":"\u0623\u064e\u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0631\u064e\u0648\u06e1\u0627\u0652 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0637\u0651\u064e\u064a\u06e1\u0631\u0650 \u0641\u064e\u0648\u06e1\u0642\u064e\u0647\u064f\u0645\u06e1 \u0635\u064e\u0670\u0653\u0641\u0651\u064e\u0670\u062a\u0656 \u0648\u064e\u064a\u064e\u0642\u06e1\u0628\u0650\u0636\u06e1\u0646\u064e\u06da \u0645\u064e\u0627 \u064a\u064f\u0645\u06e1\u0633\u0650\u0643\u064f\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f\u06da \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0628\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u0650\u06ed \u0628\u064e\u0635\u0650\u064a\u0631\u064c","translation":"\u0420\u0430\u0437\u0432\u0435 \u043e\u043d\u0438 \u043d\u0435 \u0432\u0438\u0434\u044f\u0442 \u043f\u0442\u0438\u0446 \u043d\u0430\u0434 \u0441\u043e\u0431\u043e\u0439, \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0451\u0440\u0448\u0438\u0445 \u0438 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0449\u0438\u0445 \u043a\u0440\u044b\u043b\u044c\u044f? \u041d\u0435 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0438\u0445 \u043d\u0438\u043a\u0442\u043e, \u043a\u0440\u043e\u043c\u0435 \u0412\u0441\u0435\u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u043e\u0433\u043e. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041e\u043d \u0432\u0438\u0434\u0438\u0442 \u0432\u0441\u0451 \u0441\u0443\u0449\u0435\u0435.","footnotes":""},{"id":"5261","sura":"67","aya":"20","arabic_text":"\u0623\u064e\u0645\u0651\u064e\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0647\u064f\u0648\u064e \u062c\u064f\u0646\u062f\u065e \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u064a\u064e\u0646\u0635\u064f\u0631\u064f\u0643\u064f\u0645 \u0645\u0651\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650\u06da \u0625\u0650\u0646\u0650 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u064a \u063a\u064f\u0631\u064f\u0648\u0631\u064d","translation":"\u041a\u0442\u043e \u0436\u0435 \u044d\u0442\u043e \u0432\u0430\u0448\u0435 \u0432\u043e\u0438\u043d\u0441\u0442\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043c\u0438\u043c\u043e \u0412\u0441\u0435\u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u043e\u0433\u043e? \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0435 \u0432\u0435\u0440\u0443 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u044e\u0442 \u043b\u0438\u0448\u044c \u0432 \u0441\u0430\u043c\u043e\u043e\u0431\u043e\u043b\u044c\u0449\u0435\u043d\u0438\u0438.","footnotes":""},{"id":"5262","sura":"67","aya":"21","arabic_text":"\u0623\u064e\u0645\u0651\u064e\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064e\u0631\u06e1\u0632\u064f\u0642\u064f\u0643\u064f\u0645\u06e1 \u0625\u0650\u0646\u06e1 \u0623\u064e\u0645\u06e1\u0633\u064e\u0643\u064e \u0631\u0650\u0632\u06e1\u0642\u064e\u0647\u064f\u06e5\u06da \u0628\u064e\u0644 \u0644\u0651\u064e\u062c\u0651\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u0639\u064f\u062a\u064f\u0648\u0651\u0656 \u0648\u064e\u0646\u064f\u0641\u064f\u0648\u0631\u064d","translation":"\u041a\u0442\u043e \u0436\u0435 \u043d\u0430\u0434\u0435\u043b\u0438\u0442 \u0432\u0430\u0441 \u0443\u0434\u0435\u043b\u043e\u043c, \u0435\u0441\u043b\u0438 \u041e\u043d \u0443\u0434\u0435\u0440\u0436\u0438\u0442 \u0421\u0432\u043e\u0439 \u0443\u0434\u0435\u043b? \u041d\u0435\u0442, \u043d\u0430\u043f\u0440\u043e\u0442\u0438\u0432, \u043e\u043d\u0438 \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u0443\u044e\u0442 \u0432 \u043d\u0430\u0434\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438 \u0443\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u0438!","footnotes":""},{"id":"5263","sura":"67","aya":"22","arabic_text":"\u0623\u064e\u0641\u064e\u0645\u064e\u0646 \u064a\u064e\u0645\u06e1\u0634\u0650\u064a \u0645\u064f\u0643\u0650\u0628\u0651\u064b\u0627 \u0639\u064e\u0644\u064e\u0649\u0670 \u0648\u064e\u062c\u06e1\u0647\u0650\u0647\u0650\u06e6\u0653 \u0623\u064e\u0647\u06e1\u062f\u064e\u0649\u0670\u0653 \u0623\u064e\u0645\u0651\u064e\u0646 \u064a\u064e\u0645\u06e1\u0634\u0650\u064a \u0633\u064e\u0648\u0650\u064a\u0651\u064b\u0627 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u0650\u0631\u064e\u0670\u0637\u0656 \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u0656","translation":"\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u0442\u043e\u0442, \u043a\u0442\u043e \u0438\u0434\u0451\u0442, \u043f\u0430\u0434\u0430\u044f \u043b\u0438\u0446\u043e\u043c, \u2014 \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0432\u0435\u0440\u043d\u043e\u043c \u043f\u0443\u0442\u0438, \u0447\u0435\u043c \u0442\u043e\u0442, \u043a\u0442\u043e \u0438\u0434\u0451\u0442 \u043f\u0440\u044f\u043c\u043e \u043f\u043e \u043f\u0440\u044f\u043c\u043e\u043c\u0443 \u043f\u0443\u0442\u0438?","footnotes":""},{"id":"5264","sura":"67","aya":"23","arabic_text":"\u0642\u064f\u0644\u06e1 \u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0653 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u06e1\u0639\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0641\u06e1\u0640\u0654\u0650\u062f\u064e\u0629\u064e\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u0634\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e","translation":"\u0421\u043a\u0430\u0436\u0438: \u00ab\u041e\u043d \u2014 \u0422\u043e\u0442, \u041a\u0442\u043e \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u043b \u0432\u0430\u0441, \u0438 \u0441\u0434\u0435\u043b\u0430\u043b \u0434\u043b\u044f \u0432\u0430\u0441 \u0441\u043b\u0443\u0445, \u0437\u0440\u0435\u043d\u0438\u0435 \u0438 \u0441\u0435\u0440\u0434\u0446\u0430. \u041a\u0430\u043a \u0436\u0435 \u043c\u0430\u043b\u043e \u0432\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u0442\u0435!\u00bb","footnotes":""},{"id":"5265","sura":"67","aya":"24","arabic_text":"\u0642\u064f\u0644\u06e1 \u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0630\u064e\u0631\u064e\u0623\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u062a\u064f\u062d\u06e1\u0634\u064e\u0631\u064f\u0648\u0646\u064e","translation":"\u0421\u043a\u0430\u0436\u0438: \u00ab\u041e\u043d \u2014 \u0422\u043e\u0442, \u041a\u0442\u043e \u0440\u0430\u0441\u0441\u0435\u043b\u0438\u043b \u0432\u0430\u0441 \u043d\u0430 \u0437\u0435\u043c\u043b\u0435. \u0418 \u043a \u041d\u0435\u043c\u0443 \u0432\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u044b\u00bb.","footnotes":""},{"id":"5266","sura":"67","aya":"25","arabic_text":"\u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0645\u064e\u062a\u064e\u0649\u0670 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u0648\u064e\u0639\u06e1\u062f\u064f \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"\u0418 \u043e\u043d\u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442: \u00ab\u041a\u043e\u0433\u0434\u0430 \u044d\u0442\u043e \u043e\u0431\u0435\u0449\u0430\u043d\u0438\u0435, \u0435\u0441\u043b\u0438 \u0432\u044b \u043f\u0440\u0430\u0432\u0434\u0438\u0432\u044b?\u00bb","footnotes":""},{"id":"5267","sura":"67","aya":"26","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u064f \u0639\u0650\u0646\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u064e\u0627\u06e0 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u065e","translation":"\u0421\u043a\u0430\u0436\u0438: \u00ab\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0437\u043d\u0430\u043d\u0438\u0435 \u043e\u0431 \u044d\u0442\u043e\u043c \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0443 \u0410\u043b\u043b\u0430\u0445\u0430, \u0438 \u044f \u2014 \u043b\u0438\u0448\u044c \u044f\u0441\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u044e\u0449\u0438\u0439\u00bb.","footnotes":""},{"id":"5268","sura":"67","aya":"27","arabic_text":"\u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0647\u064f \u0632\u064f\u0644\u06e1\u0641\u064e\u0629\u0657 \u0633\u0650\u064a\u0653\u0640\u0654\u064e\u062a\u06e1 \u0648\u064f\u062c\u064f\u0648\u0647\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0648\u064e\u0642\u0650\u064a\u0644\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064f\u0646\u062a\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u062a\u064e\u062f\u0651\u064e\u0639\u064f\u0648\u0646\u064e","translation":"\u041a\u043e\u0433\u0434\u0430 \u0436\u0435 \u043e\u043d\u0438 \u0443\u0432\u0438\u0434\u044f\u0442 \u0435\u0433\u043e \u0432\u0431\u043b\u0438\u0437\u0438, \u043f\u043e\u043c\u0440\u0430\u0447\u043d\u0435\u044e\u0442 \u043b\u0438\u0446\u0430 \u0442\u0435\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u0432\u0435\u0440\u0433\u043b\u0438 \u0432\u0435\u0440\u0443, \u0438 \u0431\u0443\u0434\u0435\u0442 \u0441\u043a\u0430\u0437\u0430\u043d\u043e: \u00ab\u042d\u0442\u043e \u0442\u043e, \u0447\u0442\u043e \u0432\u044b \u0442\u043e\u0440\u043e\u043f\u0438\u043b\u0438!\u00bb","footnotes":""},{"id":"5269","sura":"67","aya":"28","arabic_text":"\u0642\u064f\u0644\u06e1 \u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u06e1 \u0625\u0650\u0646\u06e1 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u064e\u0646\u0650\u064a\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0648\u064e\u0645\u064e\u0646 \u0645\u0651\u064e\u0639\u0650\u064a\u064e \u0623\u064e\u0648\u06e1 \u0631\u064e\u062d\u0650\u0645\u064e\u0646\u064e\u0627 \u0641\u064e\u0645\u064e\u0646 \u064a\u064f\u062c\u0650\u064a\u0631\u064f \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0645\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u0656","translation":"\u0421\u043a\u0430\u0436\u0438: \u00ab\u041a\u0430\u043a \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0442\u0435, \u0435\u0441\u043b\u0438 \u0410\u043b\u043b\u0430\u0445 \u043f\u043e\u0433\u0443\u0431\u0438\u0442 \u043c\u0435\u043d\u044f \u0438 \u0442\u0435\u0445, \u043a\u0442\u043e \u0441\u043e \u043c\u043d\u043e\u0439, \u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u0443\u0435\u0442 \u043d\u0430\u0441, \u0442\u043e \u043a\u0442\u043e \u0437\u0430\u0449\u0438\u0442\u0438\u0442 \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0445 \u0432\u0435\u0440\u0443 \u043e\u0442 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044f?\u00bb","footnotes":""},{"id":"5270","sura":"67","aya":"29","arabic_text":"\u0642\u064f\u0644\u06e1 \u0647\u064f\u0648\u064e \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f \u0621\u064e\u0627\u0645\u064e\u0646\u0651\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u06e1\u0646\u064e\u0627\u06d6 \u0641\u064e\u0633\u064e\u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0645\u064e\u0646\u06e1 \u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0636\u064e\u0644\u064e\u0670\u0644\u0656 \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u0656","translation":"\u0421\u043a\u0430\u0436\u0438: \u00ab\u041e\u043d \u2014 \u0412\u0441\u0435\u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u044b\u0439. \u041c\u044b \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438 \u0432 \u041d\u0435\u0433\u043e \u0438 \u043d\u0430 \u041d\u0435\u0433\u043e \u0443\u043f\u043e\u0432\u0430\u0435\u043c. \u0418 \u0432\u044b \u0441\u043a\u043e\u0440\u043e \u0443\u0437\u043d\u0430\u0435\u0442\u0435, \u043a\u0442\u043e \u0436\u0435 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u0435\u0442 \u0432 \u044f\u0432\u043d\u043e\u043c \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0438\u00bb.","footnotes":""},{"id":"5271","sura":"67","aya":"30","arabic_text":"\u0642\u064f\u0644\u06e1 \u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u06e1 \u0625\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u0628\u064e\u062d\u064e \u0645\u064e\u0627\u0653\u0624\u064f\u0643\u064f\u0645\u06e1 \u063a\u064e\u0648\u06e1\u0631\u0657\u0627 \u0641\u064e\u0645\u064e\u0646 \u064a\u064e\u0623\u06e1\u062a\u0650\u064a\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u0627\u0653\u0621\u0656 \u0645\u0651\u064e\u0639\u0650\u064a\u0646\u0650\u06ed","translation":"\u0421\u043a\u0430\u0436\u0438: \u00ab\u041a\u0430\u043a \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0442\u0435, \u0435\u0441\u043b\u0438 \u0432\u0430\u0448\u0430 \u0432\u043e\u0434\u0430 \u0443\u0439\u0434\u0451\u0442 \u0432\u0433\u043b\u0443\u0431\u044c [\u0437\u0435\u043c\u043b\u0438], \u0442\u043e \u043a\u0442\u043e \u0436\u0435 \u043f\u0440\u0438\u0434\u0451\u0442 \u043a \u0432\u0430\u043c \u0441 \u0440\u043e\u0434\u043d\u0438\u043a\u043e\u0432\u043e\u0439 \u0432\u043e\u0434\u043e\u0439?\u00bb","footnotes":""}]}