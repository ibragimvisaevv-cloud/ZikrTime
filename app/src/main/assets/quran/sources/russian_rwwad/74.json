4e\u0627 \u062a\u0650\u0633\u06e1\u0639\u064e\u0629\u064e \u0639\u064e\u0634\u064e\u0631\u064e","translation":"\u041d\u0430\u0434 \u043d\u0435\u0439 \u2014 \u0434\u0435\u0432\u044f\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u044c [\u0441\u0442\u0440\u0430\u0436\u0435\u0439].","footnotes":""},{"id":"5526","sura":"74","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0657\u06d6 \u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u0650\u062f\u0651\u064e\u062a\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u0650\u064a\u064e\u0633\u06e1\u062a\u064e\u064a\u06e1\u0642\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u064a\u064e\u0632\u06e1\u062f\u064e\u0627\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"\u041c\u044b \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0441\u0442\u0440\u0430\u0436\u0430\u043c\u0438 \u0430\u0434\u0441\u043a\u043e\u0433\u043e \u043e\u0433\u043d\u044f \u043b\u0438\u0448\u044c \u0430\u043d\u0433\u0435\u043b\u043e\u0432 \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438 \u0438\u0445 \u0447\u0438\u0441\u043b\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0442\u0435\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u0432\u0435\u0440\u0433\u043b\u0438 \u0432\u0435\u0440\u0443, \u2014 \u0447\u0442\u043e\u0431\u044b \u0443\u0431\u0435\u0434\u0438\u043b\u0438\u0441\u044c \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0431\u044b\u043b\u043e \u0434\u0430\u0440\u043e\u0432\u0430\u043d\u043e \u041f\u0438\u0441\u0430\u043d\u0438\u0435, \u0438 \u043f\u0440\u0438\u0443\u043c\u043d\u043e\u0436\u0438\u043b\u0438\u0441\u044c \u0432\u0435\u0440\u043e\u0439 \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u043b\u0438, \u0438 \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u043b\u0438\u0441\u044c \u043d\u0438 \u0442\u0435, \u043a\u043e\u043c\u0443 \u0431\u044b\u043b\u043e \u0434\u0430\u0440\u043e\u0432\u0430\u043d\u043e \u041f\u0438\u0441\u0430\u043d\u0438\u0435, \u043d\u0438 \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0435; \u0438 \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0438 \u0442\u0435, \u0432 \u0447\u044c\u0438\u0445 \u0441\u0435\u0440\u0434\u0446\u0430\u0445 \u2014 \u0431\u043e\u043b\u0435\u0437\u043d\u044c, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u0432\u0435\u0440\u0433\u0448\u0438\u0435 \u0432\u0435\u0440\u0443: \u00ab\u0427\u0442\u043e \u0445\u043e\u0442\u0435\u043b \u0410\u043b\u043b\u0430\u0445 \u044d\u0442\u0438\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c?\u00bb \u0422\u0430\u043a \u0410\u043b\u043b\u0430\u0445 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0441 \u043f\u0443\u0442\u0438, \u043a\u043e\u0433\u043e \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442, \u0438 \u043d\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043d\u0430 \u0432\u0435\u0440\u043d\u044b\u0439 \u043f\u0443\u0442\u044c, \u043a\u043e\u0433\u043e \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442. \u0412\u043e\u0438\u043d\u0441\u0442\u0432\u0430 \u0442\u0432\u043e\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442 \u043d\u0438\u043a\u0442\u043e, \u043a\u0440\u043e\u043c\u0435 \u041d\u0435\u0433\u043e. \u042d\u0442\u043e \u2014 \u043d\u0435 \u0447\u0442\u043e \u0438\u043d\u043e\u0435, \u043a\u0430\u043a \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0435\u0439.","footnotes":""},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"\u041e\u0442\u043d\u044e\u0434\u044c! \u041a\u043b\u044f\u043d\u0443\u0441\u044c \u043b\u0443\u043d\u043e\u0439,","footnotes":""},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"\u0438 \u043d\u043e\u0447\u044c\u044e, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0430 \u043e\u0442\u0441\u0442\u0443\u043f\u0430\u0435\u0442,","footnotes":""},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"\u0438 \u0443\u0442\u0440\u043e\u043c, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u043e \u0441\u0432\u0435\u0442\u043b\u0435\u0435\u0442,","footnotes":""},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"\u0432\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u044d\u0442\u043e \u2014 \u043e\u0434\u043d\u043e \u0438\u0437 \u0432\u0435\u043b\u0438\u0447\u0430\u0439\u0448\u0438\u0445 [\u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0439],","footnotes":""},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"\u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0435\u0439,","footnotes":""},