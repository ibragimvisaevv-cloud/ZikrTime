bic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0648\u0646\u064e\u0643\u064e \u0639\u064e\u0646\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u0650 \u0623\u064e\u064a\u0651\u064e\u0627\u0646\u064e \u0645\u064f\u0631\u06e1\u0633\u064e\u0649\u0670\u0647\u064e\u0627","translation":"\u041e\u043d\u0438 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u044e\u0442 \u0442\u0435\u0431\u044f \u043e \u0427\u0430\u0441\u0435: \u00ab\u041a\u043e\u0433\u0434\u0430 \u0436\u0435 \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435?\u00bb","footnotes":""},{"id":"5755","sura":"79","aya":"43","arabic_text":"\u0641\u0650\u064a\u0645\u064e \u0623\u064e\u0646\u062a\u064e \u0645\u0650\u0646 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"\u0410 \u043a\u0430\u043a\u043e\u0435 \u0442\u0435\u0431\u0435 \u0434\u0435\u043b\u043e \u0434\u043e \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u043e \u043d\u0451\u043c?","footnotes":""},{"id":"5756","sura":"79","aya":"44","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"\u041b\u0438\u0448\u044c \u0442\u0432\u043e\u0435\u043c\u0443 \u0413\u043e\u0441\u043f\u043e\u0434\u0443 [\u0432\u0435\u0434\u043e\u043c] \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0435\u043b.","footnotes":""},{"id":"5757","sura":"79","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0645\u064f\u0646\u0630\u0650\u0631\u064f \u0645\u064e\u0646 \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670\u0647\u064e\u0627","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u044b \u2014 \u043b\u0438\u0448\u044c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u044e\u0449\u0438\u0439 \u0434\u043b\u044f \u0442\u043e\u0433\u043e