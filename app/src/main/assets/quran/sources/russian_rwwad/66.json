{"result":[{"id":"5230","sura":"66","aya":"1","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u064a\u0651\u064f \u0644\u0650\u0645\u064e \u062a\u064f\u062d\u064e\u0631\u0651\u0650\u0645\u064f \u0645\u064e\u0627\u0653 \u0623\u064e\u062d\u064e\u0644\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0643\u064e\u06d6 \u062a\u064e\u0628\u06e1\u062a\u064e\u063a\u0650\u064a \u0645\u064e\u0631\u06e1\u0636\u064e\u0627\u062a\u064e \u0623\u064e\u0632\u06e1\u0648\u064e\u0670\u062c\u0650\u0643\u064e\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u063a\u064e\u0641\u064f\u0648\u0631\u065e \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u065e","translation":"\u041e \u041f\u0440\u043e\u0440\u043e\u043a! \u041f\u043e\u0447\u0435\u043c\u0443, \u0441\u0442\u0440\u0435\u043c\u044f\u0441\u044c \u0443\u0433\u043e\u0434\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u043c \u0436\u0451\u043d\u0430\u043c, \u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c \u0437\u0430\u043f\u0440\u0435\u0442\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u0442\u043e, \u0447\u0442\u043e \u0410\u043b\u043b\u0430\u0445 \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u0442\u0435\u0431\u0435? \u0410 \u0410\u043b\u043b\u0430\u0445 \u2014 \u043f\u0440\u043e\u0449\u0430\u044e\u0449\u0438\u0439, \u043c\u0438\u043b\u0443\u044e\u0449\u0438\u0439.","footnotes":""},{"id":"5231","sura":"66","aya":"2","arabic_text":"\u0642\u064e\u062f\u06e1 \u0641\u064e\u0631\u064e\u0636\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u062d\u0650\u0644\u0651\u064e\u0629\u064e \u0623\u064e\u064a\u06e1\u0645\u064e\u0670\u0646\u0650\u0643\u064f\u0645\u06e1\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0648\u06e1\u0644\u064e\u0649\u0670\u0643\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u0639\u064e\u06