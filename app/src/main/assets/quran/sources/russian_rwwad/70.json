"70","aya":"38","arabic_text":"\u0623\u064e\u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u062f\u06e1\u062e\u064e\u0644\u064e \u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0438\u0437 \u043d\u0438\u0445 \u0436\u0430\u0436\u0434\u0435\u0442, \u0447\u0442\u043e \u0435\u0433\u043e \u0432\u0432\u0435\u0434\u0443\u0442 \u0432 \u0421\u0430\u0434 \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u0438?","footnotes":""},{"id":"5414","sura":"70","aya":"39","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u041e\u0442\u043d\u044e\u0434\u044c! \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u041c\u044b \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u043b\u0438 \u0438\u0445 \u0438\u0437 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0438\u043c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e.","footnotes":""},{"id":"5415","sura":"70","aya":"40","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0645\u064e\u0634\u064e\u0670\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u063a\u064e\u0670\u0631\u0650\u0628\u0650 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u0422\u0430\u043a \u043d\u0435\u0442 \u0436\u0435! \u041a\u043b\u044f\u043d\u0443\u0441\u044c \u0413\u043e\u0441\u043f\u043e\u0434\u043e\u043c \u0432\u043e\u0441\u0445\u043e\u0434\u043e\u0432 \u0438 \u0437\u0430\u043a\u0430\u0442\u043e\u0432 \u2014 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435, \u041c\u044b \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b","footnotes":""},{"id":"5416","sura":"70","aya":"41","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"\u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c [\u0438\u0445] \u043b\u0443\u0447\u0448\u0438\u043c\u0438, \u0447\u0435\u043c \u043e\u043d\u0438, \u0438 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442 \u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0442\u044c \u041d\u0430\u0441!","footnotes":""},{"id":"5417","sura":"70","aya":"42","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062e\u064f\u0648\u0636\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u0644\u06e1\u0639\u064e\u0628\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064f\u0644\u064e\u0670\u0642\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"\u0422\u0430\u043a \u043e\u0441\u0442\u0430\u0432\u044c \u0436\u0435 \u0438\u0445 \u043f\u043e\u0433\u0440\u0443\u0436\u0451\u043d\u043d\u044b\u043c\u0438 \u0432 \u043f\u0443\u0441\u0442\u043e\u0441\u043b\u043e\u0432\u0438\u0435 \u0438 \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u043f\u043e\u043a\u0430 \u043e\u043d\u0438 \u043d\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u044f\u0442 \u0414\u0435\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u043c \u0431\u044b\u043b \u043e\u0431\u0435\u0449\u0430\u043d \u2014","footnotes":""},{"id":"5418","sura":"70","aya":"43","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u062c\u06e1\u062f\u064e\u0627\u062b\u0650 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0646\u064f\u0635\u064f\u0628\u0656 \u064a\u064f\u0648\u0641\u0650\u0636\u064f\u0648\u0646\u064e","translation":"\u0432 \u0442\u043e\u0442 \u0414\u0435\u043d\u044c, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u0432\u044b\u0439\u0434\u0443\u0442 \u0438\u0437 \u043c\u043e\u0433\u0438\u043b \u0442\u043e\u0440\u043e\u043f\u043b\u0438\u0432\u043e, \u0441\u043b\u043e\u0432\u043d\u043e \u0443\u0441\u0442\u0440\u0435\u043c\u043b\u044f\u044f\u0441\u044c \u043a \u0438\u0434\u043e\u043b\u0430\u043c.","footnotes":""},{"id":"5419","sura":"70","aya":"44","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"\u0421 \u043f\u043e\u0442\u0443\u043f\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u0432\u0437\u043e\u0440\u0430\u043c\u0438, \u043f\u043e\u043a\u0440\u044b\u0442\u044b\u0435 \u0443\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c, \u2014 \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u0434\u0435\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u043c \u0431\u044b\u043b \u043e\u0431\u0435\u0449\u0430\u043d.","footnotes":""}]}