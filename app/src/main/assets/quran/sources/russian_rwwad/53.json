e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646 \u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u064d\u06da \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0647\u06e1\u0648\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0646\u0641\u064f\u0633\u064f\u06d6 \u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653","translation":"\u042d\u0442\u043e \u2014 \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c \u0438\u043c\u0435\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043d\u0430\u0440\u0435\u043a\u043b\u0438 \u0438\u0445 \u0432\u044b \u0438 \u0432\u0430\u0448\u0438 \u043e\u0442\u0446\u044b. \u0410\u043b\u043b\u0430\u0445 \u043d\u0435 \u043d\u0438\u0441\u043f\u043e\u0441\u044b\u043b\u0430\u043b \u043e \u043d\u0438\u0445 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0434\u043e\u0432\u043e\u0434\u0430. \u041e\u043d\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0442 \u043b\u0438\u0448\u044c \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c \u0438 \u0442\u043e\u043c\u0443, \u0447\u0435\u0433\u043e \u0436\u0430\u0436\u0434\u0443\u0442 \u0438\u0445 \u0434\u0443\u0448\u0438, \u2014 \u0430 \u0432\u0435\u0434\u044c \u043a \u043d\u0438\u043c \u0443\u0436\u0435 \u043f\u0440\u0438\u0448\u043b\u043e \u0432\u0435\u0440\u043d\u043e\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043e\u0442 \u0438\u0445 \u0413\u043e\u0441\u043f\u043e\u0434\u0430.","footnotes":""},{"id":"4808","sura":"53","aya":"24","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0645\u064e\u0627 \u062a\u064e\u0645\u064e\u0646\u0651\u064e\u0649\u0670","translation":"\u0418\u043b\u0438 \u0436\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443 \u0432\u0441\u0451, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442?","footnotes":""},{"id":"4809","sura":"53","aya":"25","arabic_text":"\u0641\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"\u0410 \u0432\u0435\u0434\u044c \u0410\u043b\u043b\u0430\u0445\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442 \u0438 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u0436\u0438\u0437\u043d\u044c, \u0438 \u041f\u0435\u0440\u0432\u0430\u044f.","footnotes":""},{"id":"4810","sura":"53","aya":"26","arabic_text":"\u06de\u00a0\u0648\u064e\u0643\u064e\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0644\u064e\u0643\u0656 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0644\u064e\u0627 \u062a\u064f\u063a\u06e1\u0646\u0650\u064a \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u062a\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e2 \u0628\u064e\u0639\u06e1\u062f\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u06e1\u0630\u064e\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670\u0653","translation":"\u0418 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0436\u0435 \u0430\u043d\u0433\u0435\u043b\u043e\u0432 \u043d\u0430 \u043d\u0435\u0431\u0435\u0441\u0430\u0445, \u0447\u044c\u0451 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0438\u0447\u0443\u0442\u044c \u043d\u0435 \u043f\u043e\u043c\u043e\u0436\u0435\u0442, \u043a\u0440\u043e\u043c\u0435 \u043a\u0430\u043a \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0410\u043b\u043b\u0430\u0445 \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442 \u044d\u0442\u043e \u0434\u043b\u044f \u043a\u043e\u0433\u043e \u043f\u043e\u0436\u0435\u043b\u0430\u0435\u0442 \u0438 \u043a\u0435\u043c \u041e\u043d \u0434\u043e\u0432\u043e\u043b\u0435\u043d!","footnotes":""},{"id":"4811","sura":"53","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0644\u064e\u064a\u064f\u0633\u064e\u0645\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064e \u062a\u064e\u0633\u06e1\u0645\u0650\u064a\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"\u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0432\u0435\u0440\u0443\u044e\u0442 \u0432 \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044e\u044e \u0436\u0438\u0437\u043d\u044c, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0430\u043d\u0433\u0435\u043b\u043e\u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043c\u0438 \u0436\u0435\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043b\u0430,","footnotes":""},{"id":"4812","sura":"53","aya":"28","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u0645\u0650\u0646\u06e1 \u0639\u0650\u0644\u06e1\u0645\u064d\u06d6 \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e\u06d6 \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627","translation":"\u043d\u0435 \u0438\u043c\u0435\u044f \u043e\u0431 \u044d\u0442\u043e\u043c \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0437\u043d\u0430\u043d\u0438\u044f. \u041e\u043d\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0442 \u043b\u0438\u0448\u044c \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044e, \u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0438\u0447\u0443\u0442\u044c \u043d\u0435 \u0437\u0430\u043c\u0435\u043d\u044f\u0435\u0442 \u0438\u0441\u0442\u0438\u043d\u0443.","footnotes":""},{"id":"4813","sura":"53","aya":"29","arabic_text":"\u0641\u064e\u0623\u064e\u0639\u06e1\u0631\u0650\u0636\u06e1 \u0639\u064e\u0646 \u0645\u0651\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0639\u064e\u0646 \u0630\u0650\u0643\u06e1\u0631\u0650\u0646\u064e\u0627 \u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064f\u0631\u0650\u062f\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"\u0422\u0430\u043a \u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0441\u044c \u0436\u0435 \u043e\u0442 \u0442\u0435\u0445, \u043a\u0442\u043e \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438\u043b\u0441\u044f \u043e\u0442 \u041d\u0430\u0448\u0435\u0433\u043e \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u0438 \u0436\u0435\u043b\u0430\u0435\u0442 \u043b\u0438\u0448\u044c \u043c\u0438\u0440\u0441\u043a\u043e\u0439 \u0436\u0438\u0437\u043d\u0438.","footnotes":""},{"id":"4814","sura":"53","aya":"30","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0628\u06e1\u0644\u064e\u063a\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u0650\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646 \u0636\u064e\u0644\u0651\u064e \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u0647\u06e1\u062a\u064e\u062f\u064e\u0649\u0670","translation":"\u042d\u0442\u043e \u2014 \u043f\u0440\u0435\u0434\u0435\u043b \u0438\u0445 \u0437\u043d\u0430\u043d\u0438\u044f. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u0432\u043e\u0439 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043b\u0443\u0447\u0448\u0435 \u0437\u043d\u0430\u0435\u0442 \u0442\u0435\u0445, \u043a\u0442\u043e \u0441\u0431\u0438\u043b\u0441\u044f \u0441 \u0415\u0433\u043e \u043f\u0443\u0442\u0438, \u0438 \u043b\u0443\u0447\u0448\u0435 \u0437\u043d\u0430\u0435\u0442 \u0442\u0435\u0445, \u043a\u0442\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u0432\u0435\u0440\u043d\u044b\u043c \u043f\u0443\u0442\u0451\u043c.","footnotes":""},{"id":"4815","sura":"53","aya":"31","arabic_text":"\u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0644\u0650\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0633\u064e\u0670\u0653\u0640\u0654\u064f\u0648\u0627\u0652 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062d\u06e1\u0633\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649","translation":"\u0410\u043b\u043b\u0430\u0445\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0432\u0441\u0451, \u0447\u0442\u043e \u0432 \u043d\u0435\u0431\u0435\u0441\u0430\u0445, \u0438 \u0432\u0441\u0451, \u0447\u0442\u043e \u043d\u0430 \u0437\u0435\u043c\u043b\u0435, \u0447\u0442\u043e\u0431\u044b \u0432\u043e\u0437\u0434\u0430\u0442\u044c \u0442\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u043b\u0438 \u0434\u0443\u0440\u043d\u043e\u0435, \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u043e\u0434\u0435\u044f\u043b\u0438, \u0438 \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0434\u0438\u0442\u044c \u0442\u0435\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0432\u043e\u0440\u0438\u043b\u0438 \u0434\u043e\u0431\u0440\u043e, \u043d\u0430\u0438\u043b\u0443\u0447\u0448\u0438\u043c.","footnotes":""},{"id":"4816","sura":"53","aya":"32","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062c\u06e1\u062a\u064e\u0646\u0650\u0628\u064f\u0648\u0646\u064e \u0643\u064e\u0628\u064e\u0670\u0653\u0626\u0650\u0631\u064e \u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0641\u064e\u0648\u064e\u0670\u062d\u0650\u0634\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0644\u0651\u064e\u0645\u064e\u0645\u064e\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0648\u064e\u0670\u0633\u0650\u0639\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0643\u064f\u0645\u06e1 \u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u062c\u0650\u0646\u0651\u064e\u0629\u065e \u0641\u0650\u064a \u0628\u064f\u0637\u064f\u0648\u0646\u0650 \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u0650\u0643\u064f\u0645\u06e1\u06d6 \u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0632\u064e\u0643\u0651\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u062a\u0651\u064e\u0642\u064e\u0649\u0670\u0653","translation":"[\u042d\u0442\u043e] \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437\u0431\u0435\u0433\u0430\u044e\u0442 \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u0433\u0440\u0435\u0445\u043e\u0432 \u0438 \u043c\u0435\u0440\u0437\u043e\u0441\u0442\u0435\u0439, \u043a\u0440\u043e\u043c\u0435 \u043c\u0435\u043b\u043a\u0438\u0445 \u043f\u0440\u043e\u0441\u0442\u0443\u043f\u043a\u043e\u0432. \u0412\u043e\u0438\u0441\u0442\u0438\u043d\u0443, \u0442\u0432\u043e\u0439 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0431\u0435\u0437\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u044b\u043c \u043f\u0440\u043e\u0449\u0435\u043d\u0438\u0435\u043c. \u041e\u043d \u043b\u0443\u0447\u0448\u0435 \u0437\u043d\u0430\u043b \u0432\u0430\u0441 [\u0435\u0449\u0451] \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u043b \u0432\u0430\u0441 \u0438\u0437 \u0437\u0435\u043c\u043b\u0438 \u0438 \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u0431\u044b\u043b\u0438 \u0437\u0430\u0440\u043e\u0434\u044b\u0448\u0430\u043c\u0438 \u0432 \u0443\u0442\u0440\u043e\u0431\u0430\u0445 \u0432\u0430\u0448\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0435\u0439. \u0422\u0430\u043a \u043d\u0435 \u0432\u043e\u0441\u0445\u0432\u0430\u043b\u044f\u0439\u0442\u0435 \u0436\u0435 \u0441\u0430\u043c\u0438\u0445 \u0441\u0435\u0431\u044f \u2014 \u041e\u043d \u043b\u0443\u0447\u0448\u0435 \u0437\u043d\u0430\u0435\u0442 \u0442\u0435\u0445, \u043a\u0442\u043e \u0431\u043e\u0433\u043e\u0431\u043e\u044f\u0437\u043d\u0435\u043d.","footnotes":""},{"id":"4817","sura":"53","aya":"33","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"\u0412\u0438\u0434\u0435\u043b \u043b\u0438 \u0442\u044b \u0442\u043e\u0433\u043e, \u043a\u0442\u043e \u043e\u0442\u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f,","footnotes":""},{"id":"4818","sura":"53","aya":"34","arabic_text":"\u0648\u064e\u0623\u064e\u0639\u06e1\u0637\u064e\u0649\u0670 \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0648\u064e\u0623\u064e\u0643\u06e1\u062f\u064e\u0649\u0670\u0653","translation":"\u0434\u0430\u043b \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0438 [\u0437\u0430\u0442\u0435\u043c] \u0441\u0442\u0430\u043b \u0441\u043a\u0443\u043f\u0438\u0442\u044c\u0441\u044f?","footnotes":""},{"id":"4819","sura":"53","aya":"35","arabic_text":"\u0623\u064e\u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0639\u0650\u0644\u06e1\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u0631\u064e\u0649\u0670\u0653","translation":"\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u0443 \u043d\u0435\u0433\u043e \u2014 \u0437\u043d\u0430\u043d\u0438\u0435 \u0441\u043e\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e\u0433\u043e, \u0438 \u043e\u043d \u0432\u0438\u0434\u0438\u0442 [\u0435\u0433\u043e]?","footnotes":""},{"id":"4820","sura":"53","aya":"36","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0645\u06e1 \u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0623\u06e1 \u0628\u0650\u0645\u064e\u0627 \u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0650 \u0645\u064f\u0648\u063