\u0650","translation":"\u0422\u0430\u043a \u043a\u0430\u043a\u043e\u0435 \u0436\u0435 \u0438\u0437 \u0431\u043b\u0430\u0433 \u0432\u0430\u0448\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0432\u044b \u0434\u0432\u043e\u0435 \u0441\u043e\u0447\u0442\u0451\u0442\u0435 \u043b\u043e\u0436\u044c\u044e?","footnotes":""},{"id":"4930","sura":"55","aya":"29","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u06e5 \u0645\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06da \u0643\u064f\u0644\u0651\u064e \u064a\u064e\u0648\u06e1\u0645\u064d \u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0634\u064e\u0623\u06e1\u0646\u0656","translation":"\u0423 \u041d\u0435\u0433\u043e \u043f\u0440\u043e\u0441\u044f\u0442 \u0432\u0441\u0435, \u043a\u0442\u043e \u0432 \u043d\u0435\u0431\u0435\u0441\u0430\u0445 \u0438 \u043d\u0430 \u0437\u0435\u043c\u043b\u0435. \u041a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u041e\u043d \u2014 \u0432 \u0434\u0435\u043b\u0435.","footnotes":""},{"id":"4931","sura":"55","aya":"30","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"\u0422\u0430\u043a \u043a\u0430\u043a\u043e\u0435 \u0436\u0435 \u0438\u0437 \u0431\u043b\u0430\u0433 \u0432\u0430\u0448\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0432\u044b \u0434\u0432\u043e\u0435 \u0441\u043e\u0447\u0442\u0451\u0442\u0435 \u043b\u043e\u0436\u044c\u044e?","footnotes":""},{"id":"4932","sura":"55","aya":"31","arabic_text":"\u0633\u064e\u0646\u064e\u0641\u06e1\u0631\u064f\u063a\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e \u0671\u0644\u062b\u0651\u064e\u0642\u064e\u0644\u064e\u0627\u0646\u0650","translation":"\u0412\u0441\u043a\u043e\u0440\u0435 \u041c\u044b \u0437\u0430\u0439\u043c\u0451\u043c\u0441\u044f \u0432\u0430\u043c\u0438, \u043e \u0434\u0432\u0430 \u043e\u0442\u044f\u0433\u043e\u0449\u0451\u043d\u043d\u044b\u0445 [\u0440\u043e\u0434\u0430][70].","footnotes":"[70] \u00ab\u0414\u0432\u0430 \u043e\u0442\u044f\u0433\u043e\u0449\u0451\u043d\u043d\u044b\u0445\u00bb (\u0430\u0441-\u0441\u0430\u043a\u0430\u043b\u044f\u043d) \u2014 \u043a\u043e\u0440\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u0432\u0443\u0445 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u043c\u0438\u0440\u043e\u0432: \u043b\u044e\u0434\u0435\u0439 \u0438 \u0434\u0436\u0438\u043d\u043d\u043e\u0432."},{"id":"4933","sura":"55","aya":"32","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"\u0422\u0430\u043a \u043a\u0430\u043a\u043e\u0435 \u0436\u0435 \u0438\u0437 \u0431\u043b\u0430\u0433 \u0432\u0430\u0448\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0432\u044b \u0434\u0432\u043e\u0435 \u0441\u043e\u0447\u0442\u0451\u0442\u0435 \u043b\u043e\u0436\u044c\u044e?","footnotes":""},{"id":"4934","sura":"55","aya":"33","arabic_text":"\u064a\u064e\u0670\u0645\u064e\u0639\u06e1\u0634\u064e\u0631\u064e \u0671\u0644\u06e1\u062c\u0650\u0646\u0651\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u0650 \u0625\u0650\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u0637\u064e\u0639\u06e1\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1 \u0623\u064e\u0642\u06e1\u0637\u064e\u0627\u0631\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0641\u064e\u0671\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652\u06da \u0644\u064e\u0627 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0656","translation":"\u041e \u0441\u043e\u043d\u043c\u0438\u0449\u0435 \u0434\u0436\u0438\u043d\u043d\u043e\u0432 \u0438 \u043b\u044e\u0434\u0435\u0439! \u0415\u0441\u043b\u0438 \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u043e\u043d\u0438\u043a\u043d\u0443\u0442\u044c \u0441\u043a\u0432\u043e\u0437\u044c \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u043d\u0435\u0431\u0435\u0441 \u0438 \u0437\u0435\u043c\u043b\u0438, \u0442\u043e \u043f\u0440\u043e\u043d\u0438\u043a\u043d\u0438\u0442\u0435. \u041d\u0435 \u043f\u0440\u043e\u043d\u0438\u043a\u043d\u0438\u0442\u0435 \u0432\u044b \u0438\u043d\u0430\u0447\u0435 \u043a\u0430\u043a \u0441 \u0432\u043b\u0430\u0441\u0442\u044c\u044e.","footnotes":""},{"id":"4935","sura":"55","aya":"34","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"\u0422\u0430\u043a \u043a\u0430\u043a\u043e\u0435 \u0436\u0435 \u0438\u0437 \u0431\u043b\u0430\u0433 \u0432\u0430\u0448\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0432\u044b \u0434\u0432\u043e\u0435 \u0441\u043e\u0447\u0442\u0451\u0442\u0435 \u043b\u043e\u0436\u044c\u044e?","footnotes":""},{"id":"4936","sura":"55","aya":"35","arabic_text":"\u064a\u064f\u0631\u06e1\u0633\u064e\u0644\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u064e\u0627 \u0634\u064f\u0648\u064e\u0627\u0638\u065e \u0645\u0651\u0650\u0646 \u0646\u0651\u064e\u0627\u0631\u0656 \u0648\u064e\u0646\u064f\u062d\u064e\u0627\u0633\u065e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u062a\u064e\u0635\u0650\u0631\u064e\u0627\u0646\u0650","translation":"\u041d\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0443\u0442 \u043d\u0438\u0437\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b \u043f\u043b\u0430\u043c\u044f \u043e\u0433\u043d\u044f \u0438 \u0440\u0430\u0441\u043f\u043b\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u043c\u0435\u0434\u044c \u2014 \u0438 \u0432\u0430\u043c \u043d\u0435 \u0441\u043e\u0432\u043b\u0430\u0434\u0430\u0442\u044c.","footnotes":""},{"id":"4937","sura":"55","aya":"36","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"\u0422\u0430\u043a \u043a\u0430\u043a\u043e\u0435 \u0436\u0435 \u0438\u0437 \u0431\u043b\u0430\u0433 \u0432\u0430\u0448\u0435\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0432\u044b \u0434\u0432\u043e\u0435 \u0441\u043e\u0447\u0442\u0451\u0442\u0435 \u043b\u043e\u0436\u044c\u044e?","footnotes":""},{"id":"4938","sura":"55","aya":"37","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0648\u064e\u0631\u06e1\u062f\u064e\u0629\u0657 \u0643\u064e\u0671\u0644\u062f\u0651\u0650\u0647\u064e\u0627\u0646\u0650","translation":"\u0410 \u043a\u043e\u0433\u0434\u0430 \u0440\u0430\u0441\u043a\u043e\u043b\u0435\u0442\u0441\u044f \u043d\u0435\u0431\u043e, \u043e\u043d\u043e \u0441\u0442\u0430\u043d\u0435\u0442 \u0430\u043b\u044b\u043c, \u0441\u043b\u043e\u0432\u043d\u043e \u0440\u0430\u0441\u043a\u0430\u043b\u0451\u043d\u043d\u043e\u0435 \u043c\u0430\u0441\u043b\u043e.","footnotes":""},{"id":"4939","sura":"55","aya":"38","arabic_text":"\u0641\u064e\u0628\u0650\u062