{"result":[{"id":"5178","sura":"62","aya":"1","arabic_text":"\u064a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0671\u0644\u06e1\u0645\u064e\u0644\u0650\u0643\u0650 \u0671\u0644\u06e1\u0642\u064f\u062f\u0651\u064f\u0648\u0633\u0650 \u0671\u0644\u06e1\u0639\u064e\u0632\u0650\u064a\u0632\u0650 \u0671\u0644\u06e1\u062d\u064e\u0643\u0650\u064a\u0645\u0650","translation":"\u041f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u044f\u0435\u0442 \u0410\u043b\u043b\u0430\u0445\u0430 \u0432\u0441\u0451, \u0447\u0442\u043e \u0432 \u043d\u0435\u0431\u0435\u0441\u0430\u0445, \u0438 \u0432\u0441\u0451, \u0447\u0442\u043e \u043d\u0430 \u0437\u0435\u043c\u043b\u0435, \u2014 \u0412\u043b\u0430\u0434\u044b\u043a\u0443, \u041f\u0440\u0435\u0441\u0432\u044f\u0442\u043e\u0433\u043e, \u041c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e, \u041c\u0443\u0434\u0440\u043e\u0433\u043e.","footnotes":""},{"id":"5179","sura":"62","aya":"2","arabic_text":"\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0628\u064e\u0639\u064e\u062b\u064e \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064f\u0645\u0651\u0650\u064a\u0651\u0650\u0640\u06e7\u0646\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062a\u06e1\u0644\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u064a\u064f\u0632\u064e\u0643\u0651\u0650\u064a\u0647\u0650\u0645\u06e1 \u0648\u064e\u064a\u064f\u0639\u064e\u0644\u0651\u0650\u0645\u064f\u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\