 checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,459][970,624]" /></node><node index="3" text="Длительность паузы" resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,624][832,687]" /><node index="4" text="15 мин" resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[832,626][970,686]" /><node index="5" text="" resource-id="" class="android.widget.SeekBar" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,692][995,802]" /><node index="6" text="Пауза перед открытием приложения" resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[70,912][732,962]" /><node index="7" text="" resource-id="" class="android.view.View" package="com.zikrtime.app" content-desc="" checkable="true" checked="true" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,1052][970,1487]"><node index="0" text="Зикр перед открытием" resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[130,1082][539,1132]" /><node index="1" text="При открытии выбранного приложения появляется короткая пауза с одной фразой зикра. Затем вы выбираете намерение и время использования. Это не случайное напоминание в течение дня. Функция работает только после включения и выдачи разрешений." resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[130,1142][785,1457]" /><node index="2" text="" resource-id="" class="android.view.View" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,1052][970,1487]" /></node><node index="8" text="Паузу можно пропустить. По окончании времени — напоминание." resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,1487][970,1593]" /><node index="9" text="Сначала завершите паузу. Когда время закончится, нужна новая пауза. Лимит дня и блокировка намаза сохраняются." resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,1613][970,1772]" /><node index="10" text="Контроль работает" resource-id="" class="android.widget.TextView" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,1792][413,1837]" /><node NAF="true" index="11" text="" resource-id="" class="android.view.View" package="com.zikrtime.app" content-desc="" checkable="true" checked="true" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,1837][456,1920]"><node index="0" text="" resource-id="" class="android.widget.CheckBox" package="com.zikrtime.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[110,1857][456,1860]" /></node></node></node></node></node></node></node></node></node></node></hierarchy>