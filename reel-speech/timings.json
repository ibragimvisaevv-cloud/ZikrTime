[
  {
    "start": 0.08,
    "end": 1.422,
    "text": "Сколько осталось до асра?"
  },
  {
    "start": 1.552,
    "end": 3.191,
    "text": "Одного взгляда достаточно."
  },
  {
    "start": 4.08,
    "end": 5.06,
    "text": "Это ZikrTime."
  },
  {
    "start": 5.19,
    "end": 7.268,
    "text": "До следующего намаза — время на виджете."
  },
  {
    "start": 7.398,
    "end": 9.481,
    "text": "А здесь — всё расписание на сегодня."
  },
  {
    "start": 12.15,
    "end": 14.202,
    "text": "Можно заранее поставить напоминание"
  },
  {
    "start": 14.202,
    "end": 15.081,
    "text": "и выбрать азан."
  },
  {
    "start": 18.05,
    "end": 19.493,
    "text": "Здесь можно почитать Коран,"
  },
  {
    "start": 19.493,
    "end": 21.47,
    "text": "открыть утренние или вечерние азкары."
  },
  {
    "start": 21.6,
    "end": 22.949,
    "text": "А для зикра есть тасбих:"
  },
  {
    "start": 22.949,
    "end": 24.466,
    "text": "одно касание — один отсчёт."
  },
  {
    "start": 28.15,
    "end": 29.635,
    "text": "Можно проверить свои знания,"
  },
  {
    "start": 29.635,
    "end": 30.696,
    "text": "найти место на карте"
  },
  {
    "start": 30.696,
    "end": 31.97,
    "text": "или заглянуть в магазин."
  },
  {
    "start": 35.08,
    "end": 36.455,
    "text": "А чтобы меньше отвлекаться,"
  },
  {
    "start": 36.455,
    "end": 38.644,
    "text": "я включаю паузу перед открытием приложений."
  },
  {
    "start": 38.774,
    "end": 40.0,
    "text": "И откладываю телефон."
  },
  {
    "start": 40.13,
    "end": 41.457,
    "text": "Эти минуты — для намаза."
  },
  {
    "start": 44.1,
    "end": 44.806,
    "text": "ZikrTime."
  },
  {
    "start": 44.936,
    "end": 46.065,
    "text": "Время для главного."
  }
]