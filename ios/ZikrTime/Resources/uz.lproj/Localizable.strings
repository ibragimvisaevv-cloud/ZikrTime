"home_friday_title" = "Juma — kunlarning eng yaxshisi";
"friday_1_text" = "Kim juma kuni «Kahf» surasini oʻqisa, ikki juma orasida unga nur porlab turadi.";
"friday_1_source" = "Hokim, Bayhaqiy; Albaniy sahih degan («Sahih al-Jomeʼ», 6470)";
"friday_2_text" = "Eng afzal kunlaringizdan biri juma kunidir… Shu kuni menga koʻp salovat aytinglar, chunki salovatlaringiz menga arz qilinadi.";
"friday_2_source" = "Abu Dovud, 1047";
"friday_3_text" = "Juma kunida shunday bir soat borki, musulmon banda namozda turib unga toʻgʻri kelsa va Allohdan biror narsa soʻrasa, Alloh albatta unga beradi.";
"friday_3_source" = "Buxoriy, 935; Muslim, 852";
"friday_4_text" = "Juma kuni oʻn ikki soatdir… Oʻsha soatni asrdan keyingi oxirgi soatda izlanglar.";
"friday_4_source" = "Abu Dovud, 1048";
"friday_5_text" = "Qachon biringiz jumaga kelsa, gʻusl qilsin.";
"friday_5_source" = "Buxoriy, 877; Muslim, 844";
"friday_6_text" = "Ey iymon keltirganlar! Juma kuni namozga chaqirilganda Allohning zikriga shoshilinglar va savdoni tark qilinglar. Agar bilsangiz, bu sizlar uchun yaxshiroqdir.";
"friday_6_source" = "Qurʼon, 62:9 (maʼnolar tarjimasi)";
"friday_7_text" = "Quyosh chiqqan kunlarning eng yaxshisi juma kunidir: shu kuni Odam yaratildi, shu kuni jannatga kiritildi va shu kuni undan chiqarildi. Qiyomat ham faqat juma kuni qoim boʻladi.";
"friday_7_source" = "Muslim, 854";
