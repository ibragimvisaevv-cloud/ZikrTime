"home_friday_title" = "Жума — күндөрдүн эң жакшысы";
"friday_1_text" = "Ким жума күнү «Кахф» сүрөсүн окуса, эки жуманын ортосунда ага нур чачырап турат.";
"friday_1_source" = "аль-Хаким, аль-Байхаки; аль-Албани сахих деген («Сахих аль-Жами», 6470)";
"friday_2_text" = "Күндөрүңөрдүн эң артыктарынын бири — жума күнү… Ал күнү мага көп салават айткыла, анткени салаваттарыңар мага жеткирилет.";
"friday_2_source" = "Абу Дауд, 1047";
"friday_3_text" = "Жума күнүндө бир саат бар: мусулман пенде намазда туруп ошол саатка туш келсе жана Аллахтан бир нерсе сураса, Аллах аны сөзсүз берет.";
"friday_3_source" = "аль-Бухари, 935; Муслим, 852";
"friday_4_text" = "Жума күнү он эки саат… Ал саатты асрдан кийинки акыркы сааттан издегиле.";
"friday_4_source" = "Абу Дауд, 1048";
"friday_5_text" = "Бириңер жума намазына келгенде гусул алсын.";
"friday_5_source" = "аль-Бухари, 877; Муслим, 844";
"friday_6_text" = "Эй, ыйман келтиргендер! Жума күнү намазга чакырылганда Аллахты эскерүүгө шашылгыла жана сооданы таштагыла. Эгер билсеңер, бул силер үчүн жакшыраак.";
"friday_6_source" = "Куран, 62:9 (маани котормосу)";
"friday_7_text" = "Күн чыккан күндөрдүн эң жакшысы — жума күнү: ошол күнү Адам жаратылган, ошол күнү бейишке киргизилген жана ошол күнү андан чыгарылган. Кыямат да жума күнү гана болот.";
"friday_7_source" = "Муслим, 854";
