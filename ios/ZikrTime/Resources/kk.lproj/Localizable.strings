"friday_1_text" = "Кім жұма күні «Кәһф» сүресін оқыса, екі жұманың арасында оған нұр шашылып тұрады.";
"friday_1_source" = "әл-Хаким, әл-Бәйһақи; әл-Әлбани сахих деген («Сахих әл-Жами», 6470)";
"friday_2_text" = "Күндеріңіздің ең абзалдарының бірі — жұма күні… Сол күні маған көп салауат айтыңдар, өйткені салауаттарың маған жеткізіледі.";
"friday_2_source" = "Әбу Дәуіт, 1047";
"friday_3_text" = "Жұма күнінде бір сағат бар: мұсылман пенде намаз оқып тұрып сол сағатқа тап келсе және Алладан бір нәрсе сұраса, Алла оны міндетті түрде береді.";
"friday_3_source" = "әл-Бұхари, 935; Мүслим, 852";
"friday_4_text" = "Жұма күні он екі сағат… Ол сағатты екінтіден кейінгі соңғы сағаттан іздеңдер.";
"friday_4_source" = "Әбу Дәуіт, 1048";
"friday_5_text" = "Біреулерің жұма намазына келгенде ғұсыл алсын.";
"friday_5_source" = "әл-Бұхари, 877; Мүслим, 844";
"friday_6_text" = "Әй, иман келтіргендер! Жұма күні намазға шақырылған кезде Алланы еске алуға асығыңдар және сауданы қойыңдар. Егер білсеңдер, бұл сендер үшін қайырлы.";
"friday_6_source" = "Құран, 62:9 (мағына аудармасы)";
"friday_7_text" = "Күн шыққан күндердің ең қайырлысы — жұма күні: сол күні Адам жаратылды, сол күні жұмаққа кіргізілді және сол күні одан шығарылды. Қиямет те тек жұма күні болады.";
"friday_7_source" = "Мүслим, 854";
