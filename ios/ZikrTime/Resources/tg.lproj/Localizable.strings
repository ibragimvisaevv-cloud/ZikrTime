"alarm_ios_note" = "Дар iOS 26 ва навтар соати зангдор мисли соати системавӣ кор мекунад: ҳатто дар реҷаи бесадо ва «Фокус» занг мезанад ва дар экрани қулф хомӯш карда мешавад.";
"alarm_ios_fallback" = "Дар ин версияи iOS соати зангдор як қатор огоҳиномаҳои баланд бо азон аст: ҳар дақиқа дар давоми 10 дақиқа. Огоҳиномаҳоро хомӯш накунед ва реҷаи бесадоро фаъол накунед. Барои қатъ кардани боқимонда барномаро кушоед.";
"alarm_permission_denied" = "Соатҳои зангдор барои барнома манъ карда шудаанд. Онҳоро дар танзимот иҷозат диҳед.";
"focus_ios_text" = "Дар iPhone маҳдудияти шабакаҳои иҷтимоӣ дар версияҳои оянда пайдо мешавад: Apple ба барномаҳо дастрасӣ ба «Вақти экран»-ро танҳо пас аз санҷиши махсус медиҳад. Ҳоло аз «Вақти экран» дар танзимот истифода баред — ва аз викторина ва тасбеҳ дар ин ҷо.";
"notifications_denied" = "Огоҳиномаҳо хомӯшанд. Барои аз даст надодани вақти намоз онҳоро дар танзимот фаъол кунед.";
